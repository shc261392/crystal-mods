# Build artifacts & compiled files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# IDE & editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build outputs — generated by `make build`, never committed
dist/
build/
*.egg-info/

# Plugin build artifacts
plugin/bin/
plugin/obj/
.bepinex-refs/

# Downloaded upstream fonts / extracted game data (regenerated by scripts/)
.cache/

# Unity project scratch (the project itself is committed; its Library is not)
tools/unity-font/Library/
tools/unity-font/Temp/
tools/unity-font/Logs/
tools/unity-font/obj/

# Generated TC payload — rebuilt from source/sc by `make generate`
# The mod payload is a build product; the checked-in SC source is the truth.
payload/

# OS backups
*.bak
*.tmp

# Development workspace
.copilot_workspace/

# Accidental output from the old broken deploy.sh, which redirected its log
# lines into directory names. Removed from the repo in v1.1.0; ignored here so
# a stray checkout of an old branch cannot reintroduce them.
*Locating Black Book*