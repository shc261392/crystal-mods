# ── Crystal Mods workspace ────────────────────────────────────────────────────
# Agent-managed scratch space (per copilot-instructions). NEVER commit.
.copilot_workspace/

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~

# ── Secrets / env ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ── Python (uv) ──────────────────────────────────────────────────────────────
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/

# ── Node (Volta + pnpm) ──────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.turbo/
.next/
.nuxt/
.cache/
dist/
out/

# ── Game / mod artifacts ─────────────────────────────────────────────────────
# Binary archive formats (rebuild from source)
*.sga
*.sga.disabled
*.sga0
*.arciv
*.pak
*.pak.bak
*.uasset.bak

# Deploy state / backups produced by mod scripts at runtime
backup/
*.bak
*.old
*.tmp

# Build / release artifacts (use GitHub Releases instead)
releases/
*.zip
*.7z
!docs/**/*.zip
!**/fixtures/**/*.zip

# Extracted game references (re-extract as needed; often copyrighted)
reference/raw/
reference/extracted/

# Per-mod extracted source data (regenerate via scripts/extract_*.py)
**/extracted/

# ── Tool caches ──────────────────────────────────────────────────────────────
.tool-versions.local
*.log
