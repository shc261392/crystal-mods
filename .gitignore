# ── Crystal Mods workspace ────────────────────────────────────────────────────
# Agent-managed scratch space (per copilot-instructions). NEVER commit.
.copilot_workspace/

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~

# ── Secrets / env ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ── Python (uv) ──────────────────────────────────────────────────────────────
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/

# ── Node (Volta + pnpm) ──────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.turbo/
.next/
.nuxt/
.cache/
dist/

# EXCEPTION: Official release ZIPs (v1.0.3 and later)
!dist/wh40k-dow-de-tc-mod-v*.zip

out/

# ── Game / mod artifacts ─────────────────────────────────────────────────────
# Binary archive formats (rebuild from source)
*.sga
*.sga.disabled
*.sga0
*.arciv
*.pak
*.pak.bak
*.uasset.bak

# EXCEPTION: Official release SGA files (v1.0.3 and later)
!dawn-of-war-de/unofficial-tc-patch/EnginLocMod.sga

# Deploy state / backups produced by mod scripts at runtime
backup/
*.bak
*.old
*.tmp

# Build / release artifacts (use GitHub Releases instead)
releases/
*.zip
*.7z
!docs/**/*.zip
!**/fixtures/**/*.zip

# Local AI model artifacts (re-downloadable; not mod source)
*.safetensors
*.pth
*.pt
*.onnx
**/weights/
**/models/

# Extracted game references (re-extract as needed; often copyrighted)
reference/raw/
reference/extracted/

# Per-mod extracted source data (regenerate via scripts/extract_*.py)
**/extracted/

# Per-mod translation project source.jsonl (regenerate via scripts/build_tl_source.py).
# Keep project.json, glossary.tsv, state.jsonl in git (curated work).
**/translation/source.jsonl

# ── Tool caches ──────────────────────────────────────────────────────────────
.tool-versions.local
*.log
