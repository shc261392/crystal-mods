<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Warpstorm SchemeBuilder — renders curated Army Painter scheme packs.

    Uses the SAME recolour code as the plugin (shared/PaintMath.cs, SchemePack.cs),
    so a pack's portraits and its in-game 3D result come from one algorithm.
    Invoked by package.sh (make build); see schemes/README.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <Compile Include="../../shared/PaintMath.cs" Link="PaintMath.cs" />
    <Compile Include="../../shared/SchemePack.cs" Link="SchemePack.cs" />
  </ItemGroup>

</Project>
