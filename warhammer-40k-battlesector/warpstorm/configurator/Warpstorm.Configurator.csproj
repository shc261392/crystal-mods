<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Warpstorm Configurator — Avalonia desktop EXE.

    Loads the BattleSector Tools catalog (units/weapons/factions JSON) for an
    instant list, then reads the game's own startup bundle with AssetsTools.NET
    to fill in read-only "Original" values. Edits are exported to the Warpstorm
    plugin's JSON config.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>Warpstorm.Configurator</AssemblyName>
    <RootNamespace>Warpstorm.Configurator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Publish as a single, self-contained EXE with native libs embedded.
         Compression stays OFF: a packed/compressed payload is a common
         antivirus heuristic trigger, and a plain bundle is easier to scan. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Windows icon + version resource (Explorer "Details", Task Manager name). -->
    <ApplicationIcon>branding/warpstorm.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Warpstorm</Product>
    <AssemblyTitle>Warpstorm Configurator</AssemblyTitle>
    <Description>Warpstorm Configurator — unit, weapon and army paint editor for Warhammer 40,000: Battlesector</Description>
    <Company>crystal-mods</Company>
    <Authors>crystal-mods</Authors>
    <Copyright>Copyright © 2026 crystal-mods. Fan-made; not affiliated with Black Lab Games or Games Workshop.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <!-- Bake: managed Crunch/DXT decoder + BC3 encoder (MIT / Unlicense). -->
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- "Absorb" the BattleSector Tools catalog + the shared field schema. These
         are embedded so the published EXE is fully standalone (no data folder). -->
    <EmbeddedResource Include="../shared/fields.json" LogicalName="data/fields.json" />
    <EmbeddedResource Include="../shared/armypainter-factions.json" LogicalName="data/armypainter-factions.json" />
    <EmbeddedResource Include="../../battlesector-tools/src/data/units.json" LogicalName="data/units.json" />
    <EmbeddedResource Include="../../battlesector-tools/src/data/weapons.json" LogicalName="data/weapons.json" />
    <EmbeddedResource Include="../../battlesector-tools/src/data/factions.json" LogicalName="data/factions.json" />
    <EmbeddedResource Include="../../battlesector-tools/src/data/i18n.json" LogicalName="data/i18n.json" />
    <!-- UI string tables (validated by scripts/check-i18n.py). -->
    <EmbeddedResource Include="i18n/*.json" LogicalName="i18n/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled, downscaled unit/weapon images (generated by scripts/bundle-images.py). -->
    <AvaloniaResource Include="assets/**" />
    <AvaloniaResource Include="branding/warpstorm.png" />
    <AvaloniaResource Include="branding/fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Army Painter recolour math, shared with the plugin (live preview). -->
    <Compile Include="../shared/PaintMath.cs" Link="PaintMath.cs" />
    <Compile Include="../shared/SchemePack.cs" Link="SchemePack.cs" />
    <Compile Include="../shared/PaintCache.cs" Link="PaintCache.cs" />
  </ItemGroup>

</Project>
