---
// The Command HQ abilities live on the Factions page now (each faction shows its
// command abilities). This route redirects there.
import Base from '../layouts/Base.astro';
---

<Base
  title="Command Abilities"
  description="Command HQ abilities are now shown per faction on the Factions page."
  path="/command-abilities"
>
  <div class="surface p-12 text-center text-[var(--color-faint)]">
    <p data-i18n-ui="commandAbilities.redirecting">Redirecting to the Factions page…</p>
    <p class="mt-2"><a href="/factions" class="text-[var(--color-gold-dim)] hover:text-[var(--color-gold)] font-semibold" data-i18n-ui="nav.factions">Factions</a></p>
  </div>

  <script>
    location.replace('/factions');
  </script>
</Base>
