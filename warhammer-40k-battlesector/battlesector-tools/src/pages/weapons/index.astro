---
import WeaponRail from '../../components/WeaponRail.astro';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Weapon Database"
  description="Browse all Battlesector weapons with search, tag filters, and sortable stats."
  path="/weapons"
>
  <div class="lg:grid lg:grid-cols-[minmax(340px,380px)_1fr] lg:gap-5 lg:items-start" data-weapons-view="index">
    <div class="weapons-rail-col lg:sticky lg:top-4 lg:h-[calc(100dvh-2rem)]">
      <WeaponRail />
    </div>
    <div class="weapons-detail-col hidden lg:block">
      <div class="surface grid place-items-center min-h-[70vh] text-center p-8">
        <div>
          <p class="eyebrow mb-2" data-i18n-ui="nav.weapons">Weapons</p>
          <p class="text-lg font-semibold text-[var(--color-muted)]" data-i18n-ui="weapons.selectPrompt">Select a weapon to view its full stats.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initWeaponsBrowser } from '../../scripts/weapons';
    import { onPageLoad } from '../../scripts/reinit';
    onPageLoad(initWeaponsBrowser);
  </script>
</Base>

