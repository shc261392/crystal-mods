---
import Base from '../../layouts/Base.astro';
import { weaponSlug, weapons } from '../../lib/data';

const sorted = [...weapons].sort((a, b) => a.name.localeCompare(b.name));
const maxDamage = Math.max(...weapons.map((w) => w.damage));
---

<Base
  title="Weapon Database"
  description="Browse all Warhammer 40,000: Battlesector weapons with damage and accuracy values."
  path="/weapons"
>
  <header class="mb-6">
    <p class="eyebrow mb-2">Database</p>
    <h1 class="text-3xl md:text-4xl font-black">Weapons</h1>
    <p class="mt-2 text-[var(--color-muted)]">
      {weapons.length} weapons. Filtering is instant — no page reloads.
    </p>
  </header>

  <div class="surface p-4 mb-6 sticky top-[4.5rem] z-30">
    <div class="grid gap-3 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <label class="label block mb-1.5" for="q">Search</label>
        <input id="q" class="input" type="search" placeholder="Search by name…" autocomplete="off" />
      </div>
      <div>
        <label class="label block mb-1.5" for="sort">Sort</label>
        <select id="sort" class="select min-w-[12rem]">
          <option value="name">Name (A–Z)</option>
          <option value="damage-desc">Damage (high→low)</option>
          <option value="damage-asc">Damage (low→high)</option>
          <option value="acc-desc">Accuracy (high→low)</option>
        </select>
      </div>
    </div>
    <div class="mt-3 flex items-center justify-between">
      <p id="count" class="text-sm text-[var(--color-faint)]"></p>
      <button id="reset" type="button" class="text-sm font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]">Reset</button>
    </div>
  </div>

  <div id="grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map((w) => {
      const pct = Math.round((w.damage / maxDamage) * 100);
      return (
        <a
          href={`/weapons/${weaponSlug(w)}`}
          class="weapon-card surface surface-hover p-4 block"
          data-name={w.name.toLowerCase()}
          data-damage={w.damage}
          data-acc={w.accuracy}
        >
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-bold truncate">{w.name}</h3>
            <span class="chip !py-0.5 shrink-0">{w.isMelee ? 'Melee' : 'Ranged'}</span>
          </div>
          <div class="mt-3 flex items-end justify-between gap-4">
            <div>
              <p class="text-2xl font-black text-[var(--color-gold)] leading-none">{w.damage}</p>
              <p class="text-[10px] text-[var(--color-faint)] uppercase tracking-wide mt-1">Damage</p>
            </div>
            <div class="text-right">
              <p class="text-lg font-bold leading-none">{w.accuracy}%</p>
              <p class="text-[10px] text-[var(--color-faint)] uppercase tracking-wide mt-1">Accuracy</p>
            </div>
          </div>
          <div class="statbar mt-3"><span style={`width:${pct}%`}></span></div>
        </a>
      );
    })}
  </div>

  <p id="empty" class="hidden text-center text-[var(--color-faint)] py-16">No weapons match your search.</p>

  <script>
    import { initWeaponsBrowser } from '../../scripts/weapons';
    initWeaponsBrowser();
  </script>
</Base>
