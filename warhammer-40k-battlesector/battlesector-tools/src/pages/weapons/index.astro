---
import Tooltip from '../../components/Tooltip.astro';
import Base from '../../layouts/Base.astro';
import { damageRange, splashDamage } from '../../lib/combat';
import { weaponSlug, weapons } from '../../lib/data';
import { WEAPON_TAG_TOOLTIPS } from '../../lib/tag-tooltips';
import { resolveWeaponType, weaponTypeMeta } from '../../lib/weapon-display';
import { getWeaponPortrait, getWeaponTypeIcon } from '../../scripts/images';

const sorted = [...weapons].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="Weapon Database"
  description="Browse all Battlesector weapons with search, tag filters, and sortable stats."
  path="/weapons"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.database">Database</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.weapons">Weapons</h1>
  </header>

  <div class="surface p-4 mb-6 sticky top-[4.5rem] z-30">
    <div class="grid gap-3 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <label class="label block mb-1.5" for="q" data-i18n-ui="common.search">Search</label>
        <input id="q" class="input" type="search" placeholder="Search by name…" data-i18n-ui-placeholder="common.searchPlaceholder" autocomplete="off" />
      </div>
      <div>
        <label class="label block mb-1.5" for="sort" data-i18n-ui="common.sort">Sort</label>
        <select id="sort" class="select min-w-[12.5rem]">
          <option value="name" data-i18n-ui="weapons.sort.name">Name (A–Z)</option>
          <option value="damage-desc" data-i18n-ui="weapons.sort.damageDesc">Damage (high→low)</option>
          <option value="damage-asc" data-i18n-ui="weapons.sort.damageAsc">Damage (low→high)</option>
          <option value="acc-desc" data-i18n-ui="weapons.sort.accDesc">Accuracy (high→low)</option>
          <option value="acc-asc">Accuracy (low→high)</option>
          <option value="ap-desc">AP (high→low)</option>
          <option value="ap-asc">AP (low→high)</option>
          <option value="hits-desc">Hits (high→low)</option>
          <option value="hits-asc">Hits (low→high)</option>
        </select>
      </div>
    </div>

    <div class="mt-3">
      <p class="label mb-1.5">Tags</p>
      <div id="weapon-tag-filter" class="flex flex-wrap gap-2">
        <button type="button" class="chip cursor-pointer" data-tag="melee">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.melee}><span data-i18n-ui="common.melee">Melee</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="ballistic">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.ballistic}><span data-i18n-ui="common.ballistic">Ballistic</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="flame">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.flame}><span data-i18n-ui="common.flame">Flame</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="artillery">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.artillery}><span data-i18n-ui="common.artillery">Artillery</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="pistol">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.pistol}><span>Pistol</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="splash">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.splash}><span>Splash</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="tile">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.tile}><span>Tile-hit</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="ap">
          <Tooltip text={WEAPON_TAG_TOOLTIPS.ap}><span>AP</span></Tooltip>
        </button>
      </div>
    </div>

    <div class="mt-3 flex items-center justify-between">
      <p id="count" class="text-sm text-[var(--color-faint)]"></p>
      <button id="reset" type="button" class="text-sm font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]" data-i18n-ui="common.resetFilters">Reset filters</button>
    </div>
  </div>

  <div id="grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map((w) => {
      const dmg = damageRange(w.damage);
      const splash = splashDamage(w);
      const wType = weaponTypeMeta(w);
      const icon = getWeaponPortrait(w.icon) ?? getWeaponTypeIcon(resolveWeaponType(w));
      const hits = w.numAttacks * Math.max(1, w.shotsPerAttack || 1);
      const tags = [
        resolveWeaponType(w),
        w.pistol ? 'pistol' : null,
        w.impactType === 'splash' ? 'splash' : null,
        w.impactType === 'tile' ? 'tile' : null,
        w.armorPiercing > 0 ? 'ap' : null,
      ]
        .filter(Boolean)
        .join(',');
      return (
        <a
          href={`/weapons/${weaponSlug(w)}`}
          class="weapon-card surface surface-hover p-3 flex flex-col gap-2.5 h-full"
          data-name={w.name.toLowerCase()}
          data-id={w.id}
          data-damage={w.damage}
          data-acc={w.accuracy}
          data-ap={w.armorPiercing}
          data-hits={hits}
          data-tags={tags}
        >
          <div class="flex items-start gap-3 flex-1 min-h-0">
            <div
              class="w-14 h-14 shrink-0 rounded-lg overflow-hidden border grid place-items-center p-1.5"
              style={`border-color:color-mix(in oklab, ${wType.color} 45%, var(--color-border)); background:color-mix(in oklab, ${wType.color} 12%, var(--color-base))`}
            >
              {icon ? (
                <img src={icon} alt="" width="56" height="56" loading="lazy" class="asset-icon w-full h-full object-contain" />
              ) : (
                <span class="text-lg text-[var(--color-faint)]" aria-hidden="true">?</span>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="font-extrabold leading-tight text-sm line-clamp-2" data-i18n-weapon={w.id} data-i18n-fallback={w.name}>{w.name}</h3>
              <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                <Tooltip text={WEAPON_TAG_TOOLTIPS[wType.type]}>
                  <span class="chip !py-0.5 !px-1.5 text-[10px]" style={`color:${wType.color}`} data-i18n-ui={wType.i18nKey}>{wType.label}</span>
                </Tooltip>
                {w.pistol && (
                  <Tooltip text={WEAPON_TAG_TOOLTIPS.pistol}>
                    <span class="chip !py-0.5 !px-1.5 text-[10px]" data-i18n-ui="common.pistol">Pistol</span>
                  </Tooltip>
                )}
                {w.impactType === 'splash' && (
                  <Tooltip text={WEAPON_TAG_TOOLTIPS.splash}>
                    <span class="chip !py-0.5 !px-1.5 text-[10px] !text-[var(--color-plasma)]" data-i18n-ui="common.splash">Splash</span>
                  </Tooltip>
                )}
                {w.impactType === 'tile' && (
                  <Tooltip text={WEAPON_TAG_TOOLTIPS.tile}>
                    <span class="chip !py-0.5 !px-1.5 text-[10px] !text-[var(--color-plasma)]">Tile-hit</span>
                  </Tooltip>
                )}
                {w.abilities && w.abilities.length > 0 && (
                  <Tooltip text={`Has ${w.abilities.length} ${w.abilities.length === 1 ? 'ability' : 'abilities'}`}>
                    <span class="chip !py-0.5 !px-1.5 text-[10px] !text-[var(--color-plasma)]">Special Ability</span>
                  </Tooltip>
                )}
              </div>
            </div>
          </div>

          <dl class={`grid gap-1 ${splash ? 'grid-cols-4' : 'grid-cols-3'}`}>
            <div class="flex flex-col items-center rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-1 py-1.5">
              <dt class="text-[9px] font-semibold uppercase tracking-wide text-[var(--color-blood)]" data-i18n-ui="common.damageShort">dmg</dt>
              <dd class="text-sm font-bold tabular-nums leading-tight mt-0.5">{dmg.min}–{dmg.max}{hits > 1 ? ` (×${hits})` : ''}</dd>
            </div>
            {splash && (
              <div class="flex flex-col items-center rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-1 py-1.5">
                <dt class="text-[9px] font-semibold uppercase tracking-wide text-[var(--color-toxin)]">Splash</dt>
                <dd class="text-sm font-bold tabular-nums leading-tight mt-0.5 text-[var(--color-toxin)]">{splash.min}–{splash.max} (×{splash.models})</dd>
              </div>
            )}
            <div class="flex flex-col items-center rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-1 py-1.5 tooltip-target" data-tooltip={WEAPON_TAG_TOOLTIPS.ap}>
              <dt class="text-[9px] font-semibold uppercase tracking-wide text-[var(--color-gold)]">AP</dt>
              <dd class="text-sm font-bold tabular-nums leading-tight mt-0.5 text-[var(--color-gold)]">{w.armorPiercing}</dd>
            </div>
            <div class="flex flex-col items-center rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-1 py-1.5">
              <dt class="text-[9px] font-semibold uppercase tracking-wide text-[var(--color-plasma)]">Acc</dt>
              <dd class="text-sm font-bold tabular-nums leading-tight mt-0.5">{w.isMelee && w.accuracy <= 0 ? <span data-i18n-ui="common.melee">Melee</span> : `${w.accuracy}%`}</dd>
            </div>
          </dl>
          <div class="flex items-center justify-between rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
            <span class="text-[9px] font-semibold uppercase tracking-wide text-[#6299B8]">Range</span>
            <span class="text-xs font-bold tabular-nums">
              {w.rangeMin !== w.rangeMax ? `${w.rangeMin}–${w.rangeMax} (Optimal: ${w.rangeOptimal})` : `${w.rangeMax}`}
            </span>
          </div>
        </a>
      );
    })}
  </div>

  <p id="empty" class="hidden text-center text-[var(--color-faint)] py-16" data-i18n-ui="weapons.empty.noMatches">
    No weapons match your search.
  </p>

  <script>
    import { initWeaponsBrowser } from '../../scripts/weapons';
    import { onPageLoad } from '../../scripts/reinit';
    onPageLoad(initWeaponsBrowser);
  </script>
</Base>
