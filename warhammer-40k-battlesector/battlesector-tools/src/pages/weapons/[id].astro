---
import katex from 'katex';
import AbilityCard from '../../components/AbilityCard.astro';
import FieldNotes from '../../components/FieldNotes.astro';
import StatHexagon from '../../components/StatHexagon.astro';
import Base from '../../layouts/Base.astro';
import {
  critChance,
  damagePerHitAfterArmor,
  damageRange,
  damageRangeAfterArmor,
  expectedDamagePerHit,
  grazeChance,
  splashDamage,
} from '../../lib/combat';
import { getWeapon, idFromSlug, unitSlug, units, weaponSlug, weapons } from '../../lib/data';
import { getAbility } from '../../lib/unit-abilities';
import { resolveWeaponType, weaponTypeMeta } from '../../lib/weapon-display';
import {
  getFactionEmblem,
  getStatIcon,
  getUnitPortrait,
  getWeaponPortrait,
  getWeaponTypeIcon,
} from '../../scripts/images';

export function getStaticPaths() {
  return weapons.map((w) => ({
    params: { id: weaponSlug(w) },
    props: { weaponId: w.id },
  }));
}

const { weaponId } = Astro.props;
const weapon = getWeapon(weaponId) ?? getWeapon(idFromSlug(Astro.params.id));
if (!weapon) {
  return Astro.redirect('/units');
}

const dmgRange = damageRange(weapon.damage);
const armorTable = Array.from({ length: 10 }, (_, armor) => {
  const crit = critChance(0, weapon.armorPiercing, armor);
  const graze = grazeChance(weapon.armorPiercing, armor);
  const avgAfterArmor = damagePerHitAfterArmor(weapon.damage, armor, weapon.armorPiercing);
  const avgDamage = expectedDamagePerHit(avgAfterArmor, crit, graze);

  // Build detailed formulas for tooltips
  const { min: dmgMin, max: dmgMax } = damageRangeAfterArmor(
    weapon.damage,
    armor,
    weapon.armorPiercing,
  );
  const normalProb = 1 - crit / 100 - graze / 100;

  // Expected damage formula: shows armor subtraction and crit/graze calculation
  const expDmgFormula = `[(${dmgMin}+${dmgMax})/2] × [${normalProb.toFixed(2)}×1.0 + ${(crit / 100).toFixed(2)}×1.5 + ${(graze / 100).toFixed(2)}×0.25] = ${avgDamage.toFixed(2)}`;

  // Total damage output per attack (all shots/attacks on single model)
  const baseAcc = weapon.isMelee && weapon.accuracy <= 0 ? 80 : weapon.accuracy;
  const totalShots = weapon.numAttacks * weapon.shotsPerAttack * weapon.burstSize;
  const expectedHits = (totalShots * baseAcc) / 100;
  const totalDamage = expectedHits * avgDamage;

  // Total damage formula: full attack chain
  const totalDmgFormula = `${totalShots} shots × ${baseAcc}% acc × ${avgDamage.toFixed(2)} exp.dmg = ${totalDamage.toFixed(2)}`;

  return {
    armor,
    crit,
    graze,
    avgDamage,
    totalDamage,
    expDmgFormula,
    totalDmgFormula,
  };
});

// Units that can take this weapon.
const carriers = units
  .filter((u) =>
    u.weaponSlots.some((slot) => slot.options.some((opt) => opt.weaponId === weapon.id)),
  )
  .sort((a, b) => a.name.localeCompare(b.name));

// Weapon abilities (if any)
const weaponAbilities =
  weapon.abilities
    ?.map((a) => {
      const ability = getAbility(a.Ability);
      return ability ? { ...ability, startsLocked: a.StartsLocked === 1 } : null;
    })
    .filter(Boolean) ?? [];

const typeIcon = getWeaponTypeIcon(resolveWeaponType(weapon));
const weaponIcon = getWeaponPortrait(weapon.icon) ?? typeIcon;
const wType = weaponTypeMeta(weapon);
const splash = splashDamage(weapon);
const HP_ICON = getStatIcon('health');
const AP_ICON = getStatIcon('actionPoints');
const MP_ICON = getStatIcon('movement');
const ARMOR_ICON = getStatIcon('armor');
const DODGE_ICON = getStatIcon('evasion');

function tierMeta(
  roleName: string,
  fallbackColor: string,
): { label: string; bg: string; ink: string } {
  if (roleName === 'HQ') return { label: 'HQ', bg: '#d4af37', ink: '#1b1206' };
  if (roleName === 'Elite') return { label: 'Elite', bg: '#7e57c2', ink: '#f8f6ff' };
  if (roleName === 'Heavy Support') return { label: 'Heavy', bg: '#3b82f6', ink: '#f3f8ff' };
  if (roleName === 'Fast Attack' || roleName === 'Flyer')
    return { label: 'Fast', bg: '#22c55e', ink: '#f4fff7' };
  if (roleName === 'Troop') return { label: 'Troop', bg: '#dc2626', ink: '#fff6f6' };
  return { label: roleName, bg: fallbackColor, ink: '#f8f8f8' };
}

function hpBreakdown(total: number, perModel: number, models: number): string {
  return models > 1 ? `${total} (${perModel} x ${models})` : `${total}`;
}

function iconTintStyle(color: string): string {
  switch (color) {
    case '#39904B':
      return 'filter: brightness(0) saturate(100%) invert(43%) sepia(28%) saturate(917%) hue-rotate(83deg) brightness(94%) contrast(90%);';
    case '#8F5B36':
      return 'filter: brightness(0) saturate(100%) invert(39%) sepia(18%) saturate(1430%) hue-rotate(342deg) brightness(96%) contrast(86%);';
    case '#2662AA':
      return 'filter: brightness(0) saturate(100%) invert(30%) sepia(72%) saturate(1459%) hue-rotate(197deg) brightness(90%) contrast(94%);';
    case '#6299B8':
      return 'filter: brightness(0) saturate(100%) invert(64%) sepia(13%) saturate(1108%) hue-rotate(159deg) brightness(87%) contrast(87%);';
    default:
      return 'filter: brightness(0) saturate(100%) invert(55%) sepia(19%) saturate(585%) hue-rotate(358deg) brightness(93%) contrast(88%);';
  }
}

// Pre-calculate display strings to avoid template literal issues in JSX
const splashPct = weapon.splashFalloff ? Math.round(weapon.splashFalloff * 100) : 0;
const impactDisplay =
  weapon.impactType === 'splash'
    ? `${weapon.splashModels ?? 0} models, −${splashPct}% to secondary`
    : '';
const weaponTypeStyle = `color:${wType.color}; background:${wType.color}20`;
const accuracyDisplay = weapon.isMelee && weapon.accuracy <= 0 ? '80%' : `${weapon.accuracy}%`;
const totalShots = weapon.numAttacks * weapon.shotsPerAttack * weapon.burstSize;

// KaTeX rendered formulas
const katexOptions = { throwOnError: false, displayMode: false };

// Step 1: Armor reduction formula
const step1Formula = katex.renderToString(
  String.raw`d_{\text{range}} = (\max(d_{\text{max}} - a, 0),\, \max(0.75 \times d_{\text{max}} - a, 0))`,
  katexOptions,
);

// Step 2a: Crit chance
const step2aFormula = katex.renderToString(
  String.raw`P_{\mathrm{crit}} = 0.05 \times \max(0, \text{AP} - a)`,
  katexOptions,
);

// Step 2b: Graze chance
const step2bFormula = katex.renderToString(
  String.raw`P_{\mathrm{graze}} = 0.03 \times \max(0, a - \text{AP})`,
  katexOptions,
);

// Step 2c: Normal chance
const step2cFormula = katex.renderToString(
  String.raw`P_{\mathrm{normal}} = 1 - P_{\mathrm{crit}} - P_{\mathrm{graze}}`,
  katexOptions,
);

// Step 3: Expected damage
const step3Formula = katex.renderToString(
  String.raw`\text{E}[d] = \text{avg}(d_{\text{range}}) \times [P_{\mathrm{normal}} \times 1.0 + P_{\mathrm{crit}} \times 1.5 + P_{\mathrm{graze}} \times 0.25]`,
  katexOptions,
);

// Total damage formula
const totalDmgLatex = katex.renderToString(
  String.raw`D_{\text{total}} = (n_{\text{attacks}} \times n_{\text{shots}} \times n_{\text{burst}}) \times \frac{\text{accuracy}}{100} \times \text{E}[d]`,
  katexOptions,
);
---

<Base
  title={weapon.name}
  description={`${weapon.name} — ${weapon.damage} damage, ${weapon.accuracy}% accuracy. Battlesector weapon stats and carriers.`}
  path={`/weapons/${weaponSlug(weapon)}`}
  ogType="article"
>
  <div class="flex items-center gap-3 mb-5">
    <button type="button" data-back="/weapons/" class="btn btn-ghost btn-sm shrink-0" aria-label="Back to weapons">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      <span data-i18n-ui="common.back">Back</span>
    </button>
    <nav class="text-sm text-[var(--color-faint)] min-w-0 truncate">
      <a href="/weapons/" class="hover:text-[var(--color-gold-dim)]" data-i18n-ui="nav.weapons">Weapons</a>
      <span class="mx-1.5">/</span>
      <span class="text-[var(--color-muted)]" data-i18n-ui={wType.i18nKey}>{wType.label}</span>
    </nav>
  </div>

  <!-- Hero card: Info-dense weapon stats -->
  <div class="surface p-5 md:p-6">
    <div class="flex items-start gap-4 mb-4">
      {weaponIcon && (
        <img src={weaponIcon} alt="" width="56" height="56" loading="lazy" class="asset-icon w-14 h-14 shrink-0 object-contain rounded-lg bg-black/30 border border-[var(--color-border)] p-2" />
      )}
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-2 mb-1">
          <h1 class="text-2xl font-black" data-i18n-weapon={weapon.id} data-i18n-fallback={weapon.name}>{weapon.name}</h1>
          <span class="text-sm font-bold px-2 py-0.5 rounded" style={weaponTypeStyle} data-i18n-ui={wType.i18nKey}>{wType.label}</span>
          {weapon.pistol && <span class="text-xs font-semibold text-[var(--color-faint)]" data-i18n-ui="common.pistol">Pistol</span>}
        </div>
        
        <!-- Core stats row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2 mt-3">
          <div class="bg-[var(--color-base)] border border-[var(--color-border)] rounded-lg px-2.5 py-2 text-center">
            <div class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mb-0.5" data-i18n-ui="common.damage">Damage</div>
            <div class="text-lg font-black text-[var(--color-hp)] leading-none tabular-nums">{dmgRange.min}–{dmgRange.max}</div>
            {weapon.numAttacks > 1 && <div class="text-[10px] text-[var(--color-muted)] mt-0.5">×{weapon.numAttacks} atk</div>}
          </div>
          
          {splash && (
            <div class="bg-[var(--color-base)] border border-[var(--color-border)] rounded-lg px-2.5 py-2 text-center">
              <div class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mb-0.5" data-i18n-ui="weaponStat.splash">Splash</div>
              <div class="text-lg font-black text-[var(--color-toxin)] leading-none tabular-nums">{splash.min}–{splash.max}</div>
              <div class="text-[10px] text-[var(--color-muted)] mt-0.5">×{splash.models} models</div>
            </div>
          )}
          
          {weapon.armorPiercing > 0 && (
            <div class="bg-[var(--color-base)] border border-[var(--color-border)] rounded-lg px-2.5 py-2 text-center">
              <div class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mb-0.5">AP</div>
              <div class="text-lg font-black text-[var(--color-gold-dim)] leading-none tabular-nums">{weapon.armorPiercing}</div>
            </div>
          )}
          
          <div class="bg-[var(--color-base)] border border-[var(--color-border)] rounded-lg px-2.5 py-2 text-center">
            <div class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mb-0.5" data-i18n-ui="common.accuracy">Accuracy</div>
            {weapon.isMelee && weapon.accuracy <= 0 ? (
              <div class="text-sm font-bold leading-none mt-1" data-i18n-ui="common.melee">Melee</div>
            ) : (
              <>
                <div class="text-lg font-black text-[var(--color-gold)] leading-none tabular-nums">{weapon.accuracy}%</div>
                {weapon.isRanged && !weapon.isMelee && weapon.accuracyFalloff > 0 && (
                  <div class="text-[10px] text-[var(--color-muted)] mt-0.5">−{weapon.accuracyFalloff}/tile</div>
                )}
              </>
            )}
          </div>
          
          {weapon.isRanged && !weapon.isMelee && weapon.rangeMax > 0 && (
            <div class="bg-[var(--color-base)] border border-[var(--color-border)] rounded-lg px-2.5 py-2 text-center">
              <div class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mb-0.5" data-i18n-ui="common.range">Range</div>
              <div class="text-lg font-black leading-none tabular-nums">
                {weapon.rangeMin > 0 ? `${weapon.rangeMin}–${weapon.rangeMax}` : weapon.rangeMax}
              </div>
              {weapon.rangeOptimal !== weapon.rangeMax && (
                <div class="text-[10px] text-[var(--color-momentum)] mt-0.5">optimal: {weapon.rangeOptimal}</div>
              )}
            </div>
          )}
        </div>
        
        <!-- Mechanics info -->
        <div class="mt-3 grid gap-1.5 text-xs">
          {weapon.impactType && (
            <div class="flex items-baseline gap-2">
              <span class="text-[var(--color-faint)] min-w-[4.5rem]" data-i18n-ui="weaponDetail.impact.label">Impact:</span>
              <span class="font-semibold">
                {weapon.impactType === 'splash' && impactDisplay}
                {weapon.impactType === 'tile' && (
                  <span data-i18n-ui="weaponDetail.impact.tileFull">Every hit damages all models in the unit</span>
                )}
                {weapon.impactType === 'single' && (
                  <span data-i18n-ui="weaponDetail.impact.singleFull">Single model per hit</span>
                )}
              </span>
            </div>
          )}
          {weapon.targetType && (
            <div class="flex items-baseline gap-2">
              <span class="text-[var(--color-faint)] min-w-[4.5rem]" data-i18n-ui="weaponDetail.targeting.label">Targeting:</span>
              <span class="font-semibold">
                {weapon.targetType === 'fixedEntireUnit' ? (
                  <span data-i18n-ui="weaponDetail.targeting.fixedEntireUnit">Fixed (shots wasted if target dies early)</span>
                ) : weapon.targetType === 'redistribute' ? (
                  <span data-i18n-ui="weaponDetail.targeting.redistribute">Redistributes to living models</span>
                ) : (
                  <span data-i18n-ui="weaponDetail.targeting.fixedPerMember">Fixed per attacker</span>
                )}
              </span>
            </div>
          )}
          {weapon.isRanged && !weapon.isMelee && weapon.damageFalloff > 0 && (
            <div class="flex items-baseline gap-2">
              <span class="text-[var(--color-faint)] min-w-[4.5rem]">Dmg falloff:</span>
              <span class="font-semibold">−{weapon.damageFalloff}/tile beyond optimal range</span>
            </div>
          )}
        </div>
      </div>
    </div>
    
    <div class="flex flex-wrap gap-2 pt-3 border-t border-[var(--color-border)]">
      <button id="copy-link" type="button" class="btn btn-sm" data-url={`/weapons/${weaponSlug(weapon)}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
        <span data-i18n-ui="common.copyLink">Copy link</span>
      </button>
      <a href={`/calculator?weapon=${weapon.id}`} class="btn btn-sm btn-primary" data-i18n-ui="weaponDetail.action.openInCalculator">Open in calculator</a>
    </div>
  </div>

  <StatHexagon kind="weapon" id={weapon.id} class="mt-4 max-w-md mx-auto" />

  {weapon.description && (
    <section class="surface p-5 mt-4">
      <p class="text-sm text-[var(--color-muted)] whitespace-pre-line">{weapon.description}</p>
    </section>
  )}

  {weapon.notes && (
    <section class="mt-4">
      <FieldNotes note={weapon.notes} />
    </section>
  )}

  <div class="grid gap-4 lg:grid-cols-2 mt-4">
    <!-- Combined Crit/Graze/Expected Damage table -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-1">Critical & Graze vs Armor</h2>
      <p class="text-sm text-[var(--color-faint)] mb-3">
        Expected damage per hit accounts for armor reduction and crit/graze probabilities.
      </p>
      
      <!-- Mathematical formulas -->
      <div class="bg-[var(--color-base)] border border-[var(--color-border)] rounded-lg p-3 mb-4 text-sm">
        <div class="mb-2 text-xs text-[var(--color-faint)]">Step 1: Armor reduction</div>
        <div class="mb-3 ml-2" set:html={step1Formula} />
        
        <div class="mb-2 text-xs text-[var(--color-faint)]">Step 2: Probabilities</div>
        <div class="mb-1 ml-2" set:html={step2aFormula} />
        <div class="mb-1 ml-2" set:html={step2bFormula} />
        <div class="mb-3 ml-2" set:html={step2cFormula} />
        
        <div class="mb-2 text-xs text-[var(--color-faint)]">Step 3: Expected damage</div>
        <div class="ml-2" set:html={step3Formula} />
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-[10px] text-[var(--color-faint)] uppercase tracking-wide border-b border-[var(--color-border)]">
              <th class="text-left pb-2" data-i18n-ui="common.armor">Armor</th>
              <th class="text-right pb-2">Crit %</th>
              <th class="text-right pb-2">Graze %</th>
              <th class="text-right pb-2">Exp DMG</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)]">
            {armorTable.map((row) => (
              <tr>
                <td class="py-2 font-semibold">{row.armor}</td>
                <td class="py-2 text-right tabular-nums">
                  <span class="font-bold text-[var(--color-hp)]">{Math.round(row.crit)}%</span>
                </td>
                <td class="py-2 text-right tabular-nums">
                  <span class="font-bold text-[var(--color-momentum)]">{Math.round(row.graze)}%</span>
                </td>
                <td class="py-2 text-right tabular-nums">
                  <span class="font-bold" title={row.expDmgFormula}>{row.avgDamage.toFixed(2)}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Total damage output estimate -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-1">Estimated Total Damage Output</h2>
      <p class="text-sm text-[var(--color-faint)] mb-3">
        Total damage from a full attack sequence on a single target.
      </p>
      
      <!-- Mathematical formula -->
      <div class="bg-[var(--color-base)] border border-[var(--color-border)] rounded-lg p-3 mb-4 text-sm">
        <div class="mb-2 text-xs text-[var(--color-faint)]">Attack chain formula:</div>
        <div class="ml-2 mb-2" set:html={totalDmgLatex} />
        <div class="ml-2 text-[10px] text-[var(--color-muted)]">
          where <span set:html={katex.renderToString('E[d]', katexOptions)} /> is the expected damage per hit from the table above
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-[10px] text-[var(--color-faint)] uppercase tracking-wide border-b border-[var(--color-border)]">
              <th class="text-left pb-2" data-i18n-ui="common.armor">Armor</th>
              <th class="text-right pb-2">Total DMG</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)]">
            {armorTable.map((row) => (
              <tr>
                <td class="py-2 font-semibold">{row.armor}</td>
                <td class="py-2 text-right tabular-nums">
                  <span class="font-black text-lg text-[var(--color-gold)]" title={row.totalDmgFormula}>{row.totalDamage.toFixed(2)}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-[var(--color-faint)] mt-3">
        Based on {weapon.numAttacks} attacks × {weapon.shotsPerAttack} shots × {weapon.burstSize} burst = {totalShots} total shots at {accuracyDisplay} accuracy.
      </p>
    </section>
  </div>

  {weaponAbilities.length > 0 && (
    <section class="surface p-5 mt-4">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="common.abilities">Abilities</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {weaponAbilities.map((a) => {
          if (!a) return null;
          return (
            <AbilityCard
              {...a}
            />
          );
        })}
      </div>
    </section>
  )}

  <section class="surface p-5 mt-4">
    <h2 class="text-lg font-bold mb-4">
      <span data-i18n-ui="weaponDetail.section.carriedBy">Carried by</span> <span class="text-[var(--color-faint)] font-normal text-base">({carriers.length})</span>
    </h2>
      {carriers.length === 0 ? (
        <p class="text-sm text-[var(--color-faint)]" data-i18n-ui="weaponDetail.empty.noUnits">No units in the dataset reference this weapon.</p>
      ) : (
        <div class="space-y-2 max-h-[34rem] overflow-y-auto pr-1">
          {carriers.map((u) => {
            const thumb = getUnitPortrait(u.name, u.portrait) ?? getFactionEmblem(u.faction);
            const tier = tierMeta(u.roleName, u.roleColor);
            const tierBoxStyle = 'background:' + tier.bg + '; color:' + tier.ink;
            const tierLabelStyle = 'color:' + tier.bg;
            return (
              <a href={`/units/${unitSlug(u)}`} class="surface block p-0 overflow-hidden border border-[var(--color-border)] hover:border-[var(--color-border-strong)] transition-colors">
                <div class="grid grid-cols-[1fr_1fr] min-h-[14.5rem]">
                  <div class="p-3 flex flex-col gap-2 bg-[var(--color-base)] border-r border-[var(--color-border)]">
                    <div class="w-12 h-12 rounded-lg grid place-items-center border border-black/25 p-1 shrink-0" style={tierBoxStyle}>
                      {thumb ? (
                        <img src={thumb} alt="" width="48" height="48" loading="lazy" class="w-full h-full rounded object-contain" />
                      ) : (
                        <div class="w-full h-full rounded grid place-items-center font-black text-base" aria-hidden="true">{u.factionName.slice(0, 1)}</div>
                      )}
                    </div>
                    <span class="font-extrabold text-sm leading-tight line-clamp-2" data-i18n-unit={u.id} data-i18n-fallback={u.name}>{u.name}</span>
                    <span class="text-[11px] leading-tight text-[var(--color-muted)]" data-i18n-faction={u.faction} data-i18n-fallback={u.factionName}>{u.factionName}</span>
                    <span class="text-[11px] font-bold uppercase tracking-wide" style={tierLabelStyle}>{tier.label}</span>
                  </div>

                  <div class="p-3.5 flex flex-col">
                    <div class="ml-auto text-right">
                      <p class="text-[10px] uppercase tracking-wide text-[var(--color-faint)]">Unit PTS</p>
                      <p class="font-black text-lg text-[var(--color-gold)] leading-none">{u.pointCost}</p>
                    </div>

                    <dl class="mt-2.5 space-y-1.5">
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#39904B">
                          {HP_ICON && <img src={HP_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#39904B')} />}
                          HP
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{hpBreakdown(u.totalHealth, u.maxHealth, u.members)}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#8F5B36">
                          {AP_ICON && <img src={AP_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#8F5B36')} />}
                          AP
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.maxActionPoints}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" title="Movement Point (Move)" style="color:#2662AA">
                          {MP_ICON && <img src={MP_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#2662AA')} />}
                          MP
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.maxMovementPoints}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#6299B8">
                          {ARMOR_ICON && <img src={ARMOR_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#6299B8')} />}
                          Armor
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.armorProfile === 1 ? u.armorFront : u.armor}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#9F895A">
                          {DODGE_ICON && <img src={DODGE_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#9F895A')} />}
                          Dodge
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.evasion}</dd>
                      </div>
                    </dl>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>
</Base>
