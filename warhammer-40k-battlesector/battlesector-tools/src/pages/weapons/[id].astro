---
import Base from '../../layouts/Base.astro';
import Tooltip from '../../components/Tooltip.astro';
import { critChance, damagePerHitAfterArmor, damageRange, grazeChance } from '../../lib/combat';
import { getWeapon, idFromSlug, unitSlug, units, weaponSlug, weapons } from '../../lib/data';
import { WEAPON_TAG_TOOLTIPS } from '../../lib/tag-tooltips';
import {
  getFactionEmblem,
  getStatIcon,
  getUnitPortrait,
  getWeaponPortrait,
  getWeaponTypeIcon,
} from '../../scripts/images';

export function getStaticPaths() {
  return weapons.map((w) => ({
    params: { id: weaponSlug(w) },
    props: { weaponId: w.id },
  }));
}

const { weaponId } = Astro.props;
const weapon = getWeapon(weaponId) ?? getWeapon(idFromSlug(Astro.params.id));
if (!weapon) {
  return Astro.redirect('/units');
}

const dmgRange = damageRange(weapon.damage);
const armorTable = Array.from({ length: 10 }, (_, armor) => {
  const crit = critChance(0, weapon.armorPiercing, armor);
  const graze = grazeChance(weapon.armorPiercing, armor);
  const avgAfterArmor = damagePerHitAfterArmor(weapon.damage, armor, weapon.armorPiercing);
  const avgDamage = Math.round((avgAfterArmor * (100 - graze)) / 100);
  return {
    armor,
    crit,
    graze,
    avgDamage,
  };
});

// Units that can take this weapon.
const carriers = units
  .filter((u) =>
    u.weaponSlots.some((slot) => slot.options.some((opt) => opt.weaponId === weapon.id)),
  )
  .sort((a, b) => a.name.localeCompare(b.name));

const typeIcon = getWeaponTypeIcon(weapon.isMelee);
const weaponIcon = getWeaponPortrait(weapon.icon) ?? typeIcon;
const HP_ICON = getStatIcon('health');
const AP_ICON = getStatIcon('actionPoints');
const MP_ICON = getStatIcon('movement');
const ARMOR_ICON = getStatIcon('armor');
const DODGE_ICON = getStatIcon('evasion');

function tierMeta(roleName: string, fallbackColor: string): { label: string; bg: string; ink: string } {
  if (roleName === 'HQ') return { label: 'HQ', bg: '#d4af37', ink: '#1b1206' };
  if (roleName === 'Elite') return { label: 'Elite', bg: '#7e57c2', ink: '#f8f6ff' };
  if (roleName === 'Heavy Support') return { label: 'Heavy', bg: '#3b82f6', ink: '#f3f8ff' };
  if (roleName === 'Fast Attack' || roleName === 'Flyer') return { label: 'Fast', bg: '#22c55e', ink: '#f4fff7' };
  if (roleName === 'Troop') return { label: 'Troop', bg: '#dc2626', ink: '#fff6f6' };
  return { label: roleName, bg: fallbackColor, ink: '#f8f8f8' };
}

function hpBreakdown(total: number, perModel: number, models: number): string {
  return models > 1 ? `${total} (${perModel} x ${models})` : `${total}`;
}

function iconTintStyle(color: string): string {
  switch (color) {
    case '#39904B':
      return 'filter: brightness(0) saturate(100%) invert(43%) sepia(28%) saturate(917%) hue-rotate(83deg) brightness(94%) contrast(90%);';
    case '#8F5B36':
      return 'filter: brightness(0) saturate(100%) invert(39%) sepia(18%) saturate(1430%) hue-rotate(342deg) brightness(96%) contrast(86%);';
    case '#2662AA':
      return 'filter: brightness(0) saturate(100%) invert(30%) sepia(72%) saturate(1459%) hue-rotate(197deg) brightness(90%) contrast(94%);';
    case '#6299B8':
      return 'filter: brightness(0) saturate(100%) invert(64%) sepia(13%) saturate(1108%) hue-rotate(159deg) brightness(87%) contrast(87%);';
    default:
      return 'filter: brightness(0) saturate(100%) invert(55%) sepia(19%) saturate(585%) hue-rotate(358deg) brightness(93%) contrast(88%);';
  }
}
---

<Base
  title={weapon.name}
  description={`${weapon.name} — ${weapon.damage} damage, ${weapon.accuracy}% accuracy. Battlesector weapon stats and carriers.`}
  path={`/weapons/${weaponSlug(weapon)}`}
  ogType="article"
>
  <nav class="text-sm text-[var(--color-faint)] mb-5">
    <a href="/weapons/" class="hover:text-[var(--color-gold-dim)]" data-i18n-ui="nav.weapons">Weapons</a>
    <span class="mx-1.5">/</span>
    <span class="text-[var(--color-muted)]" data-i18n-ui={weapon.isMelee ? 'common.melee' : 'common.ranged'}>{weapon.isMelee ? 'Melee' : 'Ranged'}</span>
  </nav>

  <div class="panel-gilded p-6 md:p-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">
      <div class="flex items-center gap-4 min-w-0">
        {weaponIcon && (
          <img src={weaponIcon} alt="" width="48" height="48" loading="lazy" class="w-12 h-12 shrink-0 object-contain rounded-lg bg-black/30 border border-[var(--color-border)] p-1.5" />
        )}
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <Tooltip text={weapon.isMelee ? WEAPON_TAG_TOOLTIPS.melee : WEAPON_TAG_TOOLTIPS.ranged}>
              <span class="chip" data-i18n-ui={weapon.isMelee ? 'common.melee' : 'common.ranged'}>{weapon.isMelee ? 'Melee' : 'Ranged'}</span>
            </Tooltip>
            {weapon.pistol && (
              <Tooltip text={WEAPON_TAG_TOOLTIPS.pistol}>
                <span class="chip" data-i18n-ui="common.pistol">Pistol</span>
              </Tooltip>
            )}
            {weapon.armorPiercing > 0 && (
              <Tooltip text={WEAPON_TAG_TOOLTIPS.ap}>
                <span class="chip">AP {weapon.armorPiercing}</span>
              </Tooltip>
            )}
            {weapon.impactType === 'splash' && (weapon.splashModels ?? 0) > 1 && (
              <Tooltip text={WEAPON_TAG_TOOLTIPS.splash}>
                <span class="chip !text-[var(--color-plasma)]">
                  <span data-i18n-ui="common.splash">Splash</span> ×{weapon.splashModels}
                </span>
              </Tooltip>
            )}
            {weapon.impactType === 'tile' && (
              <Tooltip text={WEAPON_TAG_TOOLTIPS.tile}>
                <span class="chip !text-[var(--color-plasma)]" data-i18n-ui="weaponDetail.impact.tile">Hits all models</span>
              </Tooltip>
            )}
          </div>
          <h1 class="text-3xl md:text-4xl font-black" data-i18n-weapon={weapon.id} data-i18n-fallback={weapon.name}>{weapon.name}</h1>
        </div>
      </div>
      <div class="flex gap-6">
        <div class="text-center">
          <p class="text-4xl font-black text-[var(--color-gold)] leading-none whitespace-nowrap">{dmgRange.min}–{dmgRange.max}</p>
          <p class="text-xs text-[var(--color-faint)] uppercase tracking-wide mt-1.5" data-i18n-ui="common.damage">Damage</p>
        </div>
        <div class="text-center">
          {weapon.isMelee && weapon.accuracy <= 0 ? (
            <p class="text-3xl font-black leading-none mt-1.5" data-i18n-ui="common.melee">Melee</p>
          ) : (
            <p class="text-4xl font-black leading-none">{weapon.accuracy}%</p>
          )}
          <p class="text-xs text-[var(--color-faint)] uppercase tracking-wide mt-1.5" data-i18n-ui="common.accuracy">Accuracy</p>
        </div>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      <button id="copy-link" type="button" class="btn" data-url={`/weapons/${weaponSlug(weapon)}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
        <span data-i18n-ui="common.copyLink">Copy link</span>
      </button>
      <a href={`/calculator?weapon=${weapon.id}`} class="btn btn-primary" data-i18n-ui="weaponDetail.action.openInCalculator">Open in calculator</a>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 mt-4">
    <!-- Critical chance vs armor -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-1">Critical chance vs Armor</h2>
      <p class="text-sm text-[var(--color-faint)] mb-4">
        AP above target armor grants +5% critical chance per point. (Base weapon critical chance is not exposed in extracted data.)
      </p>
      <div class="space-y-1.5">
        {armorTable.map((row) => (
          <div class="flex items-center gap-3">
            <span class="text-xs text-[var(--color-faint)] w-14 shrink-0"><span data-i18n-ui="common.armor">Armor</span> {row.armor}</span>
            <div class="hud-bar flex-1"><span class="fill hp" style={`width:${Math.round(row.crit)}%`}></span></div>
            <span class="text-sm font-bold tabular-nums w-10 text-right">{Math.round(row.crit)}%</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Graze chance + expected damage vs armor -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-1" data-i18n-ui="weaponDetail.section.grazeVsArmor">Graze chance vs Armor</h2>
      <p class="text-sm text-[var(--color-faint)] mb-4">
        Expected damage uses armor subtraction first (effective armor = armor − AP, min 0),
        then applies graze chance.
      </p>
      <div class="space-y-1.5">
        {armorTable.map((row) => (
          <div class="flex items-center gap-2.5">
            <span class="text-xs text-[var(--color-faint)] w-14 shrink-0"><span data-i18n-ui="common.armor">Armor</span> {row.armor}</span>
            <div class="hud-bar flex-1"><span class="fill mom" style={`width:${Math.round(row.graze)}%`}></span></div>
            <span class="text-sm font-bold tabular-nums w-10 text-right">{Math.round(row.graze)}%</span>
            <span class="text-xs text-[var(--color-muted)] w-24 text-right tabular-nums">exp {row.avgDamage}</span>
          </div>
        ))}
      </div>
      <p class="text-xs text-[var(--color-faint)] mt-3">
        Critical bonus damage is not included (base crit damage multiplier is unknown in extracted data).
      </p>
    </section>

    <!-- Carriers -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-4">
        <span data-i18n-ui="weaponDetail.section.carriedBy">Carried by</span> <span class="text-[var(--color-faint)] font-normal text-base">({carriers.length})</span>
      </h2>
      {carriers.length === 0 ? (
        <p class="text-sm text-[var(--color-faint)]" data-i18n-ui="weaponDetail.empty.noUnits">No units in the dataset reference this weapon.</p>
      ) : (
        <div class="space-y-2 max-h-[34rem] overflow-y-auto pr-1">
          {carriers.map((u) => {
            const thumb = getUnitPortrait(u.name, u.portrait) ?? getFactionEmblem(u.faction);
            const tier = tierMeta(u.roleName, u.roleColor);
            return (
              <a href={`/units/${unitSlug(u)}`} class="surface block p-0 overflow-hidden border border-[var(--color-border)] hover:border-[var(--color-border-strong)] transition-colors">
                <div class="grid grid-cols-[1fr_1fr] min-h-[14.5rem]">
                  <div class="p-3 flex flex-col gap-2 bg-[var(--color-base)] border-r border-[var(--color-border)]">
                    <div class="w-12 h-12 rounded-lg grid place-items-center border border-black/25 p-1 shrink-0" style={`background:${tier.bg}; color:${tier.ink}`}>
                      {thumb ? (
                        <img src={thumb} alt="" width="48" height="48" loading="lazy" class="w-full h-full rounded object-contain" />
                      ) : (
                        <div class="w-full h-full rounded grid place-items-center font-black text-base" aria-hidden="true">{u.factionName.slice(0, 1)}</div>
                      )}
                    </div>
                    <span class="font-extrabold text-sm leading-tight line-clamp-2" data-i18n-unit={u.id} data-i18n-fallback={u.name}>{u.name}</span>
                    <span class="text-[11px] leading-tight text-[var(--color-muted)]" data-i18n-faction={u.faction} data-i18n-fallback={u.factionName}>{u.factionName}</span>
                    <span class="text-[11px] font-bold uppercase tracking-wide" style={`color:${tier.bg}`}>{tier.label}</span>
                  </div>

                  <div class="p-3.5 flex flex-col">
                    <div class="ml-auto text-right">
                      <p class="text-[10px] uppercase tracking-wide text-[var(--color-faint)]">Unit PTS</p>
                      <p class="font-black text-lg text-[var(--color-gold)] leading-none">{u.pointCost}</p>
                    </div>

                    <dl class="mt-2.5 space-y-1.5">
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#39904B">
                          {HP_ICON && <img src={HP_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#39904B')} />}
                          HP
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{hpBreakdown(u.totalHealth, u.maxHealth, u.members)}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#8F5B36">
                          {AP_ICON && <img src={AP_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#8F5B36')} />}
                          AP
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.maxActionPoints}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" title="Movement Point (Move)" style="color:#2662AA">
                          {MP_ICON && <img src={MP_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#2662AA')} />}
                          MP
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.maxMovementPoints}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#6299B8">
                          {ARMOR_ICON && <img src={ARMOR_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#6299B8')} />}
                          Armor
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.armorProfile === 1 ? u.armorFront : u.armor}</dd>
                      </div>
                      <div class="flex items-center justify-between gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-2 py-1.5">
                        <dt class="text-xs inline-flex items-center gap-1.5" style="color:#9F895A">
                          {DODGE_ICON && <img src={DODGE_ICON} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" style={iconTintStyle('#9F895A')} />}
                          Dodge
                        </dt>
                        <dd class="text-xs font-bold tabular-nums">{u.evasion}</dd>
                      </div>
                    </dl>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>
  </div>

  <!-- Targeting & splash mechanics -->
  <section class="surface p-5 mt-4">
    <h2 class="text-lg font-bold mb-3" data-i18n-ui="weaponDetail.section.targeting">Targeting &amp; splash</h2>
    <dl class="space-y-2.5 text-sm">
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-[var(--color-muted)]" data-i18n-ui="weaponDetail.impact.label">Impact</dt>
        <dd class="font-semibold text-right">
          {weapon.impactType === 'splash' ? (
            <span><span data-i18n-ui="weaponDetail.impact.splash">Splash</span> — {weapon.splashModels} <span data-i18n-ui="weaponDetail.impact.models">models</span>, −{Math.round((weapon.splashFalloff ?? 0) * 100)}% <span data-i18n-ui="weaponDetail.impact.toSecondary">to secondary</span></span>
          ) : weapon.impactType === 'tile' ? (
            <span data-i18n-ui="weaponDetail.impact.tileFull">Every hit damages all models in the unit</span>
          ) : (
            <span data-i18n-ui="weaponDetail.impact.singleFull">Each hit damages a single model</span>
          )}
        </dd>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-[var(--color-muted)]" data-i18n-ui="weaponDetail.targeting.label">Post-kill targeting</dt>
        <dd class="font-semibold text-right max-w-[60%]">
          {weapon.targetType === 'fixedEntireUnit' ? (
            <span data-i18n-ui="weaponDetail.targeting.fixedEntireUnit">Whole unit focuses one target; shots are wasted if it dies early</span>
          ) : weapon.targetType === 'redistribute' ? (
            <span data-i18n-ui="weaponDetail.targeting.redistribute">Attacks retarget to living models</span>
          ) : (
            <span data-i18n-ui="weaponDetail.targeting.fixedPerMember">Each attacker locks one target; its shots are wasted if that target dies</span>
          )}
        </dd>
      </div>
    </dl>
  </section>

  {weapon.isRanged && !weapon.isMelee && weapon.rangeMax > 0 && (
    <section class="surface p-5 mt-4">
      <h2 class="text-lg font-bold mb-1" data-i18n-ui="weaponDetail.section.range">Range &amp; falloff</h2>
      <p class="text-sm text-[var(--color-faint)] mb-4" data-i18n-ui="weaponDetail.note.range">
        Distances in tiles. Accuracy and damage are best within optimal range and drop off toward maximum range.
      </p>
      <div class="grid grid-cols-3 gap-3 text-center">
        <div class="rounded-lg bg-[var(--color-base)] border border-[var(--color-border)] p-3">
          <p class="text-2xl font-black tabular-nums">{weapon.rangeMin}</p>
          <p class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mt-1" data-i18n-ui="weaponDetail.range.min">Min range</p>
        </div>
        <div class="rounded-lg bg-[var(--color-base)] border border-[var(--color-gold-dim)] p-3">
          <p class="text-2xl font-black tabular-nums text-[var(--color-gold)]">{weapon.rangeOptimal}</p>
          <p class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mt-1" data-i18n-ui="weaponDetail.range.optimal">Optimal</p>
        </div>
        <div class="rounded-lg bg-[var(--color-base)] border border-[var(--color-border)] p-3">
          <p class="text-2xl font-black tabular-nums">{weapon.rangeMax}</p>
          <p class="text-[10px] uppercase tracking-wide text-[var(--color-faint)] mt-1" data-i18n-ui="weaponDetail.range.max">Max range</p>
        </div>
      </div>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        {weapon.accuracyFalloff > 0 && (
          <span class="chip"><span data-i18n-ui="weaponDetail.range.accFalloff">Accuracy falloff</span>: {weapon.accuracyFalloff}</span>
        )}
        {weapon.damageFalloff > 0 && (
          <span class="chip"><span data-i18n-ui="weaponDetail.range.dmgFalloff">Damage falloff</span>: {weapon.damageFalloff}</span>
        )}
        {weapon.ignoresRangePenalty && <span class="chip" data-i18n-ui="weaponDetail.range.ignores">Ignores range penalty</span>}
      </div>
    </section>
  )}

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>

  <script>
    import { initUnitDetail } from '../../scripts/unit-detail';
    initUnitDetail();
  </script>
</Base>
