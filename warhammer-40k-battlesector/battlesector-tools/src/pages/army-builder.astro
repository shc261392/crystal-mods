---
import Base from '../layouts/Base.astro';
import { factionColor, factions, units } from '../lib/data';
import { getFactionEmblem, getUnitPortrait } from '../scripts/images';

// Single-faction army: faction picker mirrors the unit browser's filter pills.
const factionPills = [...factions].sort((a, b) => a.name.localeCompare(b.name));
const sortedUnits = [...units].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="Army Builder"
  description="Compose a Warhammer 40,000: Battlesector army list, track points live, and share it with a single URL."
  path="/army-builder"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.tool">Tool</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.armyBuilder">Army Builder</h1>
    <p class="mt-2 text-[var(--color-muted)] max-w-2xl">
      Add units, adjust quantities and watch your point total update live. Your
      list is saved in this browser and can be shared with a link.
    </p>
  </header>

  <div class="grid gap-4 lg:grid-cols-[1fr_20rem]">
    <!-- List -->
    <section class="surface p-5 order-2 lg:order-1">
      <div class="grid gap-3 mb-4">
        <div>
          <span class="label block mb-1.5" data-i18n-ui="calculator.momentum.faction">Faction</span>
          <div id="army-faction-bar" class="flex gap-1.5 overflow-x-auto pb-1.5" role="tablist" aria-label="Faction">
            {factionPills.map((f) => (
              <button
                type="button"
                class="faction-btn shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:border-[var(--color-border-strong)] whitespace-nowrap transition-colors"
                data-faction-id={f.id}
                role="tab"
              >
                <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${factionColor(f.name)}`}></span>
                {getFactionEmblem(f.id) && (
                  <img src={getFactionEmblem(f.id)} alt="" width="16" height="16" loading="lazy" class="w-4 h-4 object-contain shrink-0" />
                )}
                <span data-i18n-faction={f.id} data-i18n-fallback={f.name}>{f.name}</span>
              </button>
            ))}
          </div>
        </div>
        <div>
          <label class="label block mb-1.5" for="unit-search" data-i18n-ui="common.search">Search</label>
          <input
            id="unit-search"
            class="input"
            type="search"
            placeholder="Search by name…"
            data-i18n-ui-placeholder="common.searchPlaceholder"
            autocomplete="off"
          />
        </div>
        <div>
          <label class="label block mb-1.5" for="unit-sort" data-i18n-ui="common.sort">Sort</label>
          <select id="unit-sort" class="select">
            <option value="name">Name (A–Z)</option>
            <option value="points-desc">Points (high→low)</option>
            <option value="points-asc">Points (low→high)</option>
          </select>
        </div>
        <div id="unit-grid" class="grid gap-2 sm:grid-cols-2 max-h-[22rem] overflow-y-auto pr-1">
          {sortedUnits.map((u) => {
            const thumb = getUnitPortrait(u.name, u.portrait) ?? getFactionEmblem(u.faction);
            return (
              <button
                type="button"
                class="unit-pick-card surface p-3 text-left w-full border border-[var(--color-border)] transition-colors hover:border-[var(--color-border-strong)]"
                data-unit-id={u.id}
                data-faction-id={u.faction}
                data-unit-name={u.name.toLowerCase()}
                data-unit-points={u.pointCost}
              >
                <div class="flex items-start gap-2.5">
                  <span class="w-1 self-stretch rounded-full shrink-0" style={`background:${u.roleColor}`}></span>
                  {thumb ? (
                    <img src={thumb} alt="" width="36" height="36" loading="lazy" class="w-9 h-9 rounded-lg object-contain bg-black/30 border border-[var(--color-border)] p-0.5 shrink-0" />
                  ) : (
                    <div class="w-9 h-9 rounded-lg grid place-items-center font-black text-xs shrink-0 border border-[var(--color-border)]" style={`background:${factionColor(u.factionName)}1f; color:${factionColor(u.factionName)}`} aria-hidden="true">{u.factionName.slice(0, 1)}</div>
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="font-semibold text-sm truncate block" data-i18n-unit={u.id} data-i18n-fallback={u.name}>{u.name}</span>
                    <span class="text-xs text-[var(--color-faint)]"><span data-i18n-role={u.role} data-i18n-fallback={u.roleName}>{u.roleName}</span></span>
                  </span>
                  <span class="text-right shrink-0">
                    <span class="font-bold text-[var(--color-gold)] leading-none">{u.pointCost}</span>
                    <span class="text-[10px] text-[var(--color-faint)] uppercase tracking-wide block mt-0.5" data-i18n-ui="common.pointsShort">pts</span>
                  </span>
                </div>
              </button>
            );
          })}
        </div>
        <div id="selected-unit-chip" class="hidden chip justify-between gap-2 px-3 py-2 text-xs"></div>
        <div id="loadout-config" class="space-y-2"></div>
        <p id="loadout-total" class="text-sm text-[var(--color-faint)]"></p>
        <button id="add-btn" type="button" class="btn btn-primary w-full" data-i18n-ui="army.addUnit">Add a unit</button>
      </div>

      <ul id="army-list" class="space-y-2"></ul>
      <p id="empty" class="text-center text-[var(--color-faint)] py-12" data-i18n-ui="army.empty">
        Your army is empty. Add a unit to begin.
      </p>
    </section>

    <!-- Summary -->
    <aside class="surface p-5 order-1 lg:order-2 lg:sticky lg:top-[4.5rem] self-start">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="common.summary">Summary</h2>
      <div class="space-y-3">
        <div>
          <p class="label" data-i18n-ui="army.summary.totalPoints">Total points</p>
          <p id="sum-points" class="text-4xl font-black text-[var(--color-gold)] tabular-nums">0</p>
        </div>
        <div class="flex gap-6">
          <div>
            <p class="label" data-i18n-ui="army.summary.units">Units</p>
            <p id="sum-units" class="text-xl font-bold tabular-nums">0</p>
          </div>
          <div>
            <p class="label" data-i18n-ui="army.summary.models">Models</p>
            <p id="sum-models" class="text-xl font-bold tabular-nums">0</p>
          </div>
        </div>
      </div>

      <div id="faction-breakdown" class="mt-4 pt-4 border-t border-[var(--color-border)] space-y-1.5"></div>

      <div class="mt-5 space-y-2">
        <button id="share-btn" type="button" class="btn btn-primary w-full" data-i18n-ui="common.copyShareLink">Copy share link</button>
        <button id="clear-btn" type="button" class="btn btn-ghost w-full" data-i18n-ui="army.button.clearArmy">Clear army</button>
      </div>
    </aside>
  </div>

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>

  <script>
    import { initArmyBuilder } from '../scripts/army-builder';
    initArmyBuilder();
  </script>
</Base>
