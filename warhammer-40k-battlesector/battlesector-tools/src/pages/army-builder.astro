---
import UnitSplitCard from '../components/UnitSplitCard.astro';
import UnitFilterFields from '../components/filters/UnitFilterFields.astro';
import Base from '../layouts/Base.astro';
import { factions, units } from '../lib/data';
import { getFactionEmblem } from '../scripts/images';

// Single-faction army: faction picker mirrors the unit browser's filter pills.
const factionPills = factions
  .filter((f) => units.some((u) => u.faction === f.id))
  .sort((a, b) => a.id - b.id);
function tierRank(roleName: string): number {
  if (roleName === 'HQ') return 0;
  if (roleName === 'Elite') return 1;
  if (roleName === 'Heavy Support') return 2;
  if (roleName === 'Fast Attack' || roleName === 'Flyer') return 3;
  if (roleName === 'Troop') return 4;
  return 99;
}

const sortedUnits = [...units].sort(
  (a, b) => tierRank(a.roleName) - tierRank(b.roleName) || a.name.localeCompare(b.name),
);
---

<Base
  title="Army Builder"
  description="Compose a Warhammer 40,000: Battlesector army list, track points live, and share it with a single URL."
  path="/army-builder"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.tool">Tool</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.armyBuilder">Army Builder</h1>
  </header>

  <div class="grid gap-4 xl:grid-cols-[1fr_20rem]">
    <!-- List -->
    <section class="surface p-5 min-w-0">
      <div class="grid gap-3 mb-4 w-full min-w-0">
        <div>
          <span class="label block mb-1.5" data-i18n-ui="calculator.momentum.faction">Faction</span>
          <div id="army-faction-bar" class="flex max-w-full flex-wrap gap-1.5 pb-1.5" role="tablist" aria-label="Faction">
            {factionPills.map((f) => (
              <button
                type="button"
                class="faction-btn shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:border-[var(--color-border-strong)] whitespace-nowrap transition-colors"
                data-faction-id={f.id}
                role="tab"
              >
                {getFactionEmblem(f.id) && (
                  <img src={getFactionEmblem(f.id)} alt="" width="16" height="16" loading="lazy" class="w-4 h-4 object-contain shrink-0" />
                )}
                <span data-i18n-faction={f.id} data-i18n-fallback={f.name}>{f.name}</span>
              </button>
            ))}
          </div>
        </div>
        <div>
          <label class="label block mb-1.5" for="unit-search" data-i18n-ui="common.search">Search</label>
          <input
            id="unit-search"
            class="input"
            type="search"
            placeholder="Search by name…"
            data-i18n-ui-placeholder="common.searchPlaceholder"
            autocomplete="off"
          />
        </div>
        <UnitFilterFields roleId="unit-role" sortId="unit-sort" campaignId="show-campaign-units" tagFilterId="army-unit-tag-filter" />
        <div id="unit-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-2 2xl:grid-cols-3 w-full min-w-0 max-w-full">
          {sortedUnits.map((u) => {
            return (
              <UnitSplitCard
                unit={u}
                variant="tall"
                className="unit-pick-card text-left w-full cursor-pointer"
                dataAttrs={{
                  'data-unit-id': u.id,
                  'data-faction-id': u.faction,
                  'data-unit-name': u.name.toLowerCase(),
                  'data-unit-points': u.pointCost,
                  'data-tier-rank': tierRank(u.roleName),
                  'data-role': u.roleName,
                  'data-hp': u.totalHealth,
                  'data-armor': u.armor,
                  'data-move': u.maxMovementPoints,
                  'data-tags': [
                    u.roleName === 'HQ' ? 'hq' : null,
                    u.isLarge ? 'large' : null,
                    u.campaignOnly ? 'campaign' : null,
                    u.canMeleeReact ? 'melee-reaction' : null,
                    u.canFallback ? 'fallback' : null,
                  ]
                    .filter(Boolean)
                    .join(','),
                }}
              />
            );
          })}
        </div>
      </div>

      <ul id="army-list" class="space-y-2"></ul>
      <p id="empty" class="text-center text-[var(--color-faint)] py-12" data-i18n-ui="army.empty">
        Your army is empty. Add a unit to begin.
      </p>
    </section>

    <!-- Summary -->
    <aside
      id="army-summary-panel"
      class="hidden surface p-5 min-w-0 fixed right-4 top-[5.5rem] left-auto w-[22rem] max-w-[calc(100vw-2rem)] z-[120] max-h-[70vh] overflow-y-auto xl:block xl:sticky xl:right-auto xl:top-[4.5rem] xl:w-auto xl:max-w-none xl:z-auto xl:max-h-none xl:overflow-visible self-start"
    >
      <div class="xl:hidden mb-3 flex items-center justify-between">
        <h2 class="text-base font-bold" data-i18n-ui="common.summary">Summary</h2>
        <button id="summary-close-btn" type="button" class="btn btn-ghost !px-2 !py-1" aria-label="Close summary">✕</button>
      </div>
      <h2 class="hidden xl:block text-lg font-bold mb-4" data-i18n-ui="common.summary">Summary</h2>
      <div class="space-y-3">
        <div>
          <p class="label" data-i18n-ui="army.summary.totalPoints">Total points</p>
          <p id="sum-points" class="text-4xl font-black text-[var(--color-gold)] tabular-nums">0</p>
        </div>
        <div class="flex gap-6">
          <div>
            <p class="label" data-i18n-ui="army.summary.units">Units</p>
            <p id="sum-units" class="text-xl font-bold tabular-nums">0</p>
          </div>
          <div>
            <p class="label" data-i18n-ui="army.summary.models">Models</p>
            <p id="sum-models" class="text-xl font-bold tabular-nums">0</p>
          </div>
        </div>
      </div>

      <div id="faction-breakdown" class="mt-4 pt-4 border-t border-[var(--color-border)] space-y-1.5"></div>

      <div class="mt-5 space-y-2">
        <button id="share-btn" type="button" class="btn btn-primary w-full" data-i18n-ui="common.copyShareLink">Copy share link</button>
        <button id="clear-btn" type="button" class="btn btn-ghost w-full" data-i18n-ui="army.button.clearArmy">Clear army</button>
      </div>
    </aside>
  </div>

  <button
    id="summary-fab"
    type="button"
    class="fixed top-[4.75rem] right-4 z-[110] btn btn-primary !inline-flex xl:!hidden"
    aria-controls="army-summary-panel"
    aria-expanded="false"
  >
    <span data-i18n-ui="common.summary">Summary</span>
  </button>

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>

  <script>
    import { initArmyBuilder } from '../scripts/army-builder';
    import { onPageLoad, pageSignal } from '../scripts/reinit';
    onPageLoad(() => {
      initArmyBuilder();

      const panel = document.getElementById('army-summary-panel');
      const fab = document.getElementById('summary-fab');
      const closeBtn = document.getElementById('summary-close-btn');
      if (!panel || !fab) return;
      const signal = pageSignal('army-panel');
      const placeFloatingPanel = () => {
        if (window.innerWidth >= 1280) {
          panel.style.top = '';
          panel.style.right = '';
          panel.style.left = '';
          return;
        }
        panel.style.top = `${window.scrollY + 88}px`;
        panel.style.right = '16px';
        panel.style.left = 'auto';
      };

      const openPanel = () => {
        placeFloatingPanel();
        panel.classList.remove('hidden');
        fab.setAttribute('aria-expanded', 'true');
      };
      const closePanel = () => {
        panel.classList.add('hidden');
        fab.setAttribute('aria-expanded', 'false');
      };
      fab.addEventListener('click', () => {
        if (panel.classList.contains('hidden')) openPanel();
        else closePanel();
      });
      closeBtn?.addEventListener('click', closePanel);
      window.addEventListener(
        'resize',
        () => {
          if (window.innerWidth >= 1280) {
            panel.style.top = '';
            panel.style.right = '';
            panel.style.left = '';
            panel.classList.remove('hidden');
          } else {
            closePanel();
          }
        },
        { signal },
      );
      window.addEventListener(
        'scroll',
        () => {
          if (window.innerWidth < 1280 && !panel.classList.contains('hidden')) {
            placeFloatingPanel();
          }
        },
        { signal },
      );
    });
  </script>
</Base>
