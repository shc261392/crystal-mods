---
import Base from '../layouts/Base.astro';
import Tooltip from '../components/Tooltip.astro';
import UnitSplitCard from '../components/UnitSplitCard.astro';
import { factions, roles, units } from '../lib/data';
import { UNIT_TAG_TOOLTIPS } from '../lib/tag-tooltips';
import { getFactionEmblem } from '../scripts/images';

// Single-faction army: faction picker mirrors the unit browser's filter pills.
const factionPills = factions
  .filter((f) => units.some((u) => u.faction === f.id))
  .sort((a, b) => a.id - b.id);
const roleNames = [...roles]
  .sort((a, b) => a.sort - b.sort)
  .map((r) => r.name)
  .filter((n) => units.some((u) => u.roleName === n));
function tierRank(roleName: string): number {
  if (roleName === 'HQ') return 0;
  if (roleName === 'Elite') return 1;
  if (roleName === 'Heavy Support') return 2;
  if (roleName === 'Fast Attack' || roleName === 'Flyer') return 3;
  if (roleName === 'Troop') return 4;
  return 99;
}

const sortedUnits = [...units].sort(
  (a, b) => tierRank(a.roleName) - tierRank(b.roleName) || a.name.localeCompare(b.name),
);

---

<Base
  title="Army Builder"
  description="Compose a Warhammer 40,000: Battlesector army list, track points live, and share it with a single URL."
  path="/army-builder"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.tool">Tool</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.armyBuilder">Army Builder</h1>
    <p class="mt-2 text-[var(--color-muted)] max-w-2xl">
      Add units, adjust quantities and watch your point total update live. Your
      list is saved in this browser and can be shared with a link.
    </p>
  </header>

  <div class="grid gap-4 lg:grid-cols-[1fr_20rem]">
    <!-- List -->
    <section class="surface p-5 order-2 lg:order-1 min-w-0">
      <div class="grid gap-3 mb-4 w-full min-w-0">
        <div>
          <span class="label block mb-1.5" data-i18n-ui="calculator.momentum.faction">Faction</span>
          <div id="army-faction-bar" class="flex max-w-full flex-wrap gap-1.5 pb-1.5" role="tablist" aria-label="Faction">
            {factionPills.map((f) => (
              <button
                type="button"
                class="faction-btn shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:border-[var(--color-border-strong)] whitespace-nowrap transition-colors"
                data-faction-id={f.id}
                role="tab"
              >
                {getFactionEmblem(f.id) && (
                  <img src={getFactionEmblem(f.id)} alt="" width="16" height="16" loading="lazy" class="w-4 h-4 object-contain shrink-0" />
                )}
                <span data-i18n-faction={f.id} data-i18n-fallback={f.name}>{f.name}</span>
              </button>
            ))}
          </div>
        </div>
        <div>
          <label class="label block mb-1.5" for="unit-search" data-i18n-ui="common.search">Search</label>
          <input
            id="unit-search"
            class="input"
            type="search"
            placeholder="Search by name…"
            data-i18n-ui-placeholder="common.searchPlaceholder"
            autocomplete="off"
          />
        </div>
        <div>
          <label class="label block mb-1.5" for="unit-sort" data-i18n-ui="common.sort">Sort</label>
          <select id="unit-sort" class="select">
            <option value="tier-name">Tier (HQ→Troop), Name (A–Z)</option>
            <option value="name">Name (A–Z)</option>
            <option value="name-desc">Name (Z–A)</option>
            <option value="points-desc">Points (high→low)</option>
            <option value="points-asc">Points (low→high)</option>
            <option value="hp-desc">Health (high→low)</option>
            <option value="hp-asc">Health (low→high)</option>
            <option value="armor-desc">Armor (high→low)</option>
            <option value="armor-asc">Armor (low→high)</option>
            <option value="move-desc">Movement (high→low)</option>
            <option value="move-asc">Movement (low→high)</option>
          </select>
        </div>
        <div>
          <label class="label block mb-1.5" for="unit-role" data-i18n-ui="common.role">Role</label>
          <select id="unit-role" class="select">
            <option value="" data-i18n-ui="units.filter.allRoles">All roles</option>
            {roleNames.map((r) => {
              const sample = units.find((u) => u.roleName === r);
              return (
                <option value={r} data-role-id={sample?.role ?? ''}>
                  {r}
                </option>
              );
            })}
          </select>
        </div>
        <div>
          <label class="label inline-flex items-center gap-2 cursor-pointer select-none" for="show-campaign-units">
            <input id="show-campaign-units" type="checkbox" class="accent-[var(--color-gold)]" />
            <span>Show campaign units</span>
          </label>
        </div>
        <div>
          <p class="label mb-1.5">Tags</p>
          <div id="army-unit-tag-filter" class="flex flex-wrap gap-2">
            <button type="button" class="chip cursor-pointer" data-tag="hq">
              <Tooltip text={UNIT_TAG_TOOLTIPS.hq}><span>HQ</span></Tooltip>
            </button>
            <button type="button" class="chip cursor-pointer" data-tag="large">
              <Tooltip text={UNIT_TAG_TOOLTIPS.large}><span data-i18n-ui="common.large">Large</span></Tooltip>
            </button>
            <button type="button" class="chip cursor-pointer" data-tag="campaign">
              <Tooltip text={UNIT_TAG_TOOLTIPS.campaignOnly}><span data-i18n-ui="common.campaignOnly">Campaign only</span></Tooltip>
            </button>
            <button type="button" class="chip cursor-pointer" data-tag="melee-reaction">
              <Tooltip text={UNIT_TAG_TOOLTIPS.meleeReaction}><span data-i18n-ui="unitDetail.tag.meleeReaction">Melee Reaction</span></Tooltip>
            </button>
            <button type="button" class="chip cursor-pointer" data-tag="fallback">
              <Tooltip text={UNIT_TAG_TOOLTIPS.fallback}><span data-i18n-ui="unitDetail.tag.canFallBack">Can Fall Back</span></Tooltip>
            </button>
          </div>
        </div>
        <div id="unit-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 w-full min-w-0 max-w-full max-h-[32rem] overflow-y-auto pr-1">
          {sortedUnits.map((u) => {
            return (
              <UnitSplitCard
                unit={u}
                className="unit-pick-card text-left w-full cursor-pointer"
                dataAttrs={{
                  'data-unit-id': u.id,
                  'data-faction-id': u.faction,
                  'data-unit-name': u.name.toLowerCase(),
                  'data-unit-points': u.pointCost,
                  'data-tier-rank': tierRank(u.roleName),
                  'data-role': u.roleName,
                  'data-hp': u.totalHealth,
                  'data-armor': u.armor,
                  'data-move': u.maxMovementPoints,
                  'data-tags': [
                    u.roleName === 'HQ' ? 'hq' : null,
                    u.isLarge ? 'large' : null,
                    u.campaignOnly ? 'campaign' : null,
                    u.canMeleeReact ? 'melee-reaction' : null,
                    u.canFallback ? 'fallback' : null,
                  ]
                    .filter(Boolean)
                    .join(','),
                }}
              />
            );
          })}
        </div>
        <div id="selected-unit-chip" class="hidden chip justify-between gap-2 px-3 py-2 text-xs"></div>
        <div id="loadout-config" class="space-y-2"></div>
        <p id="loadout-total" class="text-sm text-[var(--color-faint)]"></p>
        <button id="add-btn" type="button" class="btn btn-primary w-full" data-i18n-ui="army.addUnit">Add a unit</button>
      </div>

      <ul id="army-list" class="space-y-2"></ul>
      <p id="empty" class="text-center text-[var(--color-faint)] py-12" data-i18n-ui="army.empty">
        Your army is empty. Add a unit to begin.
      </p>
    </section>

    <!-- Summary -->
    <aside class="surface p-5 order-1 lg:order-2 lg:sticky lg:top-[4.5rem] self-start min-w-0">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="common.summary">Summary</h2>
      <div class="space-y-3">
        <div>
          <p class="label" data-i18n-ui="army.summary.totalPoints">Total points</p>
          <p id="sum-points" class="text-4xl font-black text-[var(--color-gold)] tabular-nums">0</p>
        </div>
        <div class="flex gap-6">
          <div>
            <p class="label" data-i18n-ui="army.summary.units">Units</p>
            <p id="sum-units" class="text-xl font-bold tabular-nums">0</p>
          </div>
          <div>
            <p class="label" data-i18n-ui="army.summary.models">Models</p>
            <p id="sum-models" class="text-xl font-bold tabular-nums">0</p>
          </div>
        </div>
      </div>

      <div id="faction-breakdown" class="mt-4 pt-4 border-t border-[var(--color-border)] space-y-1.5"></div>

      <div class="mt-5 space-y-2">
        <button id="share-btn" type="button" class="btn btn-primary w-full" data-i18n-ui="common.copyShareLink">Copy share link</button>
        <button id="clear-btn" type="button" class="btn btn-ghost w-full" data-i18n-ui="army.button.clearArmy">Clear army</button>
      </div>
    </aside>
  </div>

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>

  <script>
    import { initArmyBuilder } from '../scripts/army-builder';
    initArmyBuilder();
  </script>
</Base>
