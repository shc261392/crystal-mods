---
import Base from '../layouts/Base.astro';
import { factionColor, factions, roles, summary, units } from '../lib/data';
import { getFactionEmblem } from '../scripts/images';

const factionCards = factions
  .filter((f) => summary.factions.includes(f.name))
  .sort((a, b) => a.name.localeCompare(b.name));

const tools = [
  {
    href: '/units',
    title: 'Unit Database',
    titleKey: 'home.tool.units.title',
    desc: 'Browse all units with complete stats, armor, weapons, and abilities for tactical planning.',
    descKey: 'home.tool.units.desc',
    icon: '◈',
    accent: 'var(--color-gold)',
  },
  {
    href: '/weapons/',
    title: 'Weapon Database',
    titleKey: 'home.tool.weapons.title',
    desc: 'Every weapon with damage and accuracy. Sort and filter to find the right tool for the job.',
    descKey: 'home.tool.weapons.desc',
    icon: '⚔',
    accent: 'var(--color-blood)',
  },
  {
    href: '/army-builder',
    title: 'Army Builder',
    titleKey: 'home.tool.army.title',
    desc: 'Compose a list, track points live, and share it with a single URL. Saved automatically in your browser.',
    descKey: 'home.tool.army.desc',
    icon: '▦',
    accent: 'var(--color-plasma)',
  },
  {
    href: '/calculator',
    title: 'Damage Calculator',
    titleKey: 'home.tool.calculator.title',
    desc: 'Model damage vs armor, hit chance and expected casualties using the real in-game formulas.',
    descKey: 'home.tool.calculator.desc',
    icon: '∑',
    accent: 'var(--color-toxin)',
  },
  {
    href: '/units?compare=1',
    title: 'Unit Comparison',
    titleKey: 'home.tool.compare.title',
    desc: 'Put units side by side and see every stat difference at a glance. Linkable for sharing matchups.',
    descKey: 'home.tool.compare.desc',
    icon: '⇄',
    accent: 'var(--color-warp)',
  },
];

const topUnits = [...units].sort((a, b) => b.totalHealth - a.totalHealth).slice(0, 6);
---

<Base title="Battlesector Tools">
  <!-- Hero -->
  <section class="relative overflow-hidden surface px-6 py-12 md:px-12 md:py-16">
    <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full blur-3xl opacity-30" style="background: radial-gradient(circle, var(--color-gold), transparent 70%)"></div>
    <div class="relative max-w-3xl">
      <p class="eyebrow mb-3" data-i18n-ui="home.eyebrow">Warhammer 40,000: Battlesector</p>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05]">
        <span data-i18n-ui="home.hero.title">The complete tactical toolkit for Battlesector</span>
      </h1>
      <p class="mt-5 text-lg text-[var(--color-muted)] max-w-2xl" data-i18n-ui="home.hero.subtitle">
        Plan armies, evaluate damage, and compare units using extracted in-game
        data.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/units" class="btn btn-primary" data-i18n-ui="home.cta.exploreUnits">Explore units</a>
        <a href="/army-builder" class="btn" data-i18n-ui="home.cta.buildArmy">Build an army</a>
      </div>

      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl">
        <div>
          <dt class="label" data-i18n-ui="home.stats.units">Units</dt>
          <dd class="text-2xl font-bold">{summary.unitCount}</dd>
        </div>
        <div>
          <dt class="label" data-i18n-ui="home.stats.weapons">Weapons</dt>
          <dd class="text-2xl font-bold">{summary.weaponCount}</dd>
        </div>
        <div>
          <dt class="label" data-i18n-ui="home.stats.factions">Factions</dt>
          <dd class="text-2xl font-bold">{factions.length}</dd>
        </div>
        <div>
          <dt class="label" data-i18n-ui="home.stats.roles">Roles</dt>
          <dd class="text-2xl font-bold">{roles.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Tools grid -->
  <section class="mt-12">
    <h2 class="text-xl font-bold mb-5" data-i18n-ui="home.section.tools">Tools</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((t) => (
        <a href={t.href} class="surface surface-hover p-6 group relative overflow-hidden">
          <div class="flex items-start gap-4">
            <span class="grid place-items-center w-11 h-11 rounded-xl text-xl font-bold shrink-0" style={`background: color-mix(in oklab, ${t.accent} 20%, transparent); color: ${t.accent}`}>{t.icon}</span>
            <div>
              <h3 class="font-bold text-lg group-hover:text-[var(--color-gold)] transition-colors" data-i18n-ui={t.titleKey}>{t.title}</h3>
              <p class="mt-1.5 text-sm text-[var(--color-muted)] leading-relaxed" data-i18n-ui={t.descKey}>{t.desc}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Roadmap -->
  <section class="mt-12">
    <h2 class="text-xl font-bold mb-5">Roadmap</h2>
    <div class="grid gap-4 lg:grid-cols-2">
      <article class="surface p-5">
        <h3 class="font-bold text-[var(--color-toxin)] mb-3">Done</h3>
        <ul class="space-y-2 text-sm text-[var(--color-muted)] list-disc pl-5">
          <li>Published unit and weapon databases with search, sort, and multi-language support.</li>
          <li>Released calculator, compare tools, and momentum modeling for battle estimation.</li>
          <li>Added army builder with share links, faction locking, and loadout point calculations.</li>
          <li>Improved UI consistency (card layouts, faction visuals, and faster browsing workflows).</li>
        </ul>
      </article>

      <article class="surface p-5">
        <h3 class="font-bold text-[var(--color-gold)] mb-3">Missing / In progress</h3>
        <ul class="space-y-2 text-sm text-[var(--color-muted)] list-disc pl-5">
          <li>Review all unit stat and weapon stat (Blood Angels and Tyranids fully reviewed).</li>
          <li>Add unit abilities (active and passive).</li>
          <li>Add mechanism explanation for unit/weapon tags and combat formula.</li>
          <li>Add crticial hit multiplier in Calculator.</li>
          <li>Revise Army builder and Weapons page.</li>
          <li>Allow unit/weapon browser to filter by tags.</li>
          <li>Allow user comments and user uploading screenshots.</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- Factions -->
  <section class="mt-12">
    <h2 class="text-xl font-bold mb-5" data-i18n-ui="home.section.factions">Factions</h2>
    <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
      {factionCards.map((f) => {
        const emblem = getFactionEmblem(f.id);
        const color = factionColor(f.name);
        return (
        <a href={`/units?faction=${encodeURIComponent(f.name)}`} class="surface surface-hover p-3 flex items-center gap-3">
          {emblem ? (
            <img src={emblem} alt="" width="44" height="44" loading="lazy" class="w-11 h-11 rounded-lg object-contain bg-black/30 border border-[var(--color-border)] p-0.5 shrink-0" />
          ) : (
            <div class="w-11 h-11 rounded-lg grid place-items-center font-black shrink-0 border border-[var(--color-border)]" style={`background:${color}1f; color:${color}`} aria-hidden="true">{f.name.slice(0, 1)}</div>
          )}
          <div class="min-w-0">
            <p class="font-semibold truncate text-sm" data-i18n-faction={f.id} data-i18n-fallback={f.name}>{f.name}</p>
            <p class="text-xs text-[var(--color-faint)] truncate">{f.slogan}</p>
          </div>
        </a>
        );
      })}
    </div>
  </section>

  <!-- Toughest units preview -->
  <section class="mt-12">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-bold" data-i18n-ui="home.section.toughestUnits">Toughest units</h2>
      <a href="/units" class="text-sm font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]" data-i18n-ui="home.viewAll">View all →</a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {topUnits.map((u) => (
        <a href={`/units/${u.id}-${u.name.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}`} class="surface surface-hover p-4 flex items-center gap-3">
          <span class="w-1 h-12 rounded-full shrink-0" style={`background:${u.roleColor}`}></span>
          <div class="min-w-0 flex-1">
            <p class="font-semibold truncate" data-i18n-unit={u.id} data-i18n-fallback={u.name}>{u.name}</p>
            <p class="text-xs text-[var(--color-faint)] flex flex-wrap items-center gap-x-2"><span data-i18n-faction={u.faction} data-i18n-fallback={u.factionName}>{u.factionName}</span><span class="opacity-60" data-i18n-role={u.role} data-i18n-fallback={u.roleName}>{u.roleName}</span></p>
          </div>
          <div class="text-right shrink-0">
            <p class="font-bold text-[var(--color-gold)]">{u.totalHealth}</p>
            <p class="text-[10px] text-[var(--color-faint)] uppercase tracking-wide" data-i18n-ui="common.hpShort">HP</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
