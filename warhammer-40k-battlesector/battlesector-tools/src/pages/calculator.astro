---
import Base from '../layouts/Base.astro';
---

<Base
  title="Damage Calculator"
  description="Model Battlesector damage vs armor, hit chance and expected casualties using the real in-game formulas."
  path="/calculator"
>
  <header class="mb-6">
    <p class="eyebrow mb-2">Tool</p>
    <h1 class="text-3xl md:text-4xl font-black">Damage Calculator</h1>
    <p class="mt-2 text-[var(--color-muted)] max-w-2xl">
      Pick an attacking weapon and a target, or enter custom values. Results use
      the extracted formulas: damage minus effective armor (min 1), hit chance
      clamped 0–100%, and no overflow between models.
    </p>
  </header>

  <div class="grid gap-4 lg:grid-cols-[1fr_1fr_1.1fr]">
    <!-- Attacker -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-4">Attacker</h2>
      <label class="label block mb-1.5" for="weapon">Weapon</label>
      <select id="weapon" class="select mb-4"></select>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="label block mb-1.5" for="damage">Damage</label>
          <input id="damage" class="input" type="number" min="0" inputmode="numeric" />
        </div>
        <div>
          <label class="label block mb-1.5" for="accuracy">Accuracy %</label>
          <input id="accuracy" class="input" type="number" min="0" max="100" inputmode="numeric" />
        </div>
        <div>
          <label class="label block mb-1.5" for="ap">Armor Pierce</label>
          <input id="ap" class="input" type="number" min="0" inputmode="numeric" />
        </div>
        <div>
          <label class="label block mb-1.5" for="accmod">Acc. Modifier</label>
          <input id="accmod" class="input" type="number" inputmode="numeric" value="0" />
        </div>
        <div>
          <label class="label block mb-1.5" for="shots">Shots / attack</label>
          <input id="shots" class="input" type="number" min="1" inputmode="numeric" value="1" />
        </div>
      </div>
    </section>

    <!-- Target -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-4">Target</h2>
      <label class="label block mb-1.5" for="unit">Unit</label>
      <select id="unit" class="select mb-4"></select>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="label block mb-1.5" for="armor">Armor</label>
          <input id="armor" class="input" type="number" min="0" inputmode="numeric" value="0" />
        </div>
        <div>
          <label class="label block mb-1.5" for="evasion">Evasion</label>
          <input id="evasion" class="input" type="number" inputmode="numeric" value="0" />
        </div>
        <div>
          <label class="label block mb-1.5" for="hpmodel">HP / model</label>
          <input id="hpmodel" class="input" type="number" min="1" inputmode="numeric" value="20" />
        </div>
        <div>
          <label class="label block mb-1.5" for="members">Models</label>
          <input id="members" class="input" type="number" min="1" inputmode="numeric" value="1" />
        </div>
      </div>
    </section>

    <!-- Results -->
    <section class="surface p-5 lg:row-span-1 relative overflow-hidden">
      <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full blur-3xl opacity-20" style="background:radial-gradient(circle,var(--color-toxin),transparent 70%)"></div>
      <h2 class="text-lg font-bold mb-4">Results</h2>
      <div class="space-y-3 relative">
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]">Damage per hit</span>
          <span id="r-perhit" class="text-2xl font-black text-[var(--color-gold)] tabular-nums">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]">Hit chance</span>
          <span id="r-hit" class="text-xl font-bold tabular-nums">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]">Damage per attack</span>
          <span id="r-attack" class="text-xl font-bold tabular-nums">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]">Expected (× hit %)</span>
          <span id="r-expected" class="text-xl font-bold tabular-nums">—</span>
        </div>
        <div class="border-t border-[var(--color-border)] my-3"></div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]">Models killed (raw)</span>
          <span id="r-killed" class="text-xl font-bold tabular-nums">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]">Target total HP</span>
          <span id="r-totalhp" class="text-base font-semibold tabular-nums text-[var(--color-faint)]">—</span>
        </div>
      </div>
      <button id="copy-link" type="button" class="btn w-full mt-5" data-url="">
        Copy shareable link
      </button>
    </section>
  </div>

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>

  <script>
    import { initCalculator } from '../scripts/calculator';
    initCalculator();
  </script>
</Base>
