---
import Base from '../layouts/Base.astro';
---

<Base
  title="Damage Calculator"
  description="Model Battlesector damage vs armor, hit chance and expected casualties using the real in-game formulas."
  path="/calculator"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.tool">Tool</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.calculator">Damage Calculator</h1>
    <p class="mt-2 text-[var(--color-muted)] max-w-2xl">
      Pick an attacking weapon and a target, or enter custom values. Damage is the
      in-game range (min = 75% of max), hit chance = accuracy − evasion, and armour
      raises graze/crit chance rather than subtracting damage.
    </p>
  </header>

  <!-- Mode toggle -->
  <div class="inline-flex gap-1 surface !p-1 mb-5" role="tablist" aria-label="Calculator mode">
    <button id="mode-oneround-btn" type="button" role="tab" class="mode-btn px-4 py-2 rounded-lg text-sm font-bold transition-colors" data-i18n-ui="calculator.mode.oneRound">One-round test</button>
    <button id="mode-battle-btn" type="button" role="tab" class="mode-btn px-4 py-2 rounded-lg text-sm font-bold transition-colors text-[var(--color-muted)]" data-i18n-ui="calculator.mode.battle">Battle simulation</button>
  </div>

  <div id="mode-oneround">
  <div class="grid gap-4 lg:grid-cols-[1fr_1fr_1.1fr]">
    <!-- Attacker -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="common.attacker">Attacker</h2>
      <label class="label block mb-1.5" for="attacker-unit" data-i18n-ui="common.unit">Unit</label>
      <select id="attacker-unit" class="select mb-3"></select>
      <label class="label block mb-1.5" for="weapon" data-i18n-ui="common.weapon">Weapon</label>
      <select id="weapon" class="select mb-4"></select>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="label block mb-1.5" for="damage" data-i18n-ui="common.damage">Damage</label>
          <input id="damage" class="input" type="number" min="0" inputmode="numeric" />
        </div>
        <div>
          <label class="label block mb-1.5" for="accuracy" data-i18n-ui="common.accuracy">Accuracy %</label>
          <input id="accuracy" class="input" type="number" min="0" max="100" inputmode="numeric" />
        </div>
        <div>
          <label class="label block mb-1.5" for="ap">Armor Pierce</label>
          <input id="ap" class="input" type="number" min="0" inputmode="numeric" />
        </div>
        <div>
          <label class="label block mb-1.5" for="accmod">Acc. Modifier</label>
          <input id="accmod" class="input" type="number" inputmode="numeric" value="0" />
        </div>
        <div>
          <label class="label block mb-1.5" for="shots" data-i18n-ui="calculator.attacker.totalShots">Total shots (squad)</label>
          <input id="shots" class="input" type="number" min="1" inputmode="numeric" value="1" />
        </div>
        <div>
          <label class="label block mb-1.5" for="dmgmod" data-i18n-ui="calculator.buff.damageMod">Damage modifier</label>
          <input id="dmgmod" class="input" type="number" inputmode="numeric" value="0" />
        </div>
      </div>

      <!-- Momentum & faction passive (auto from this unit's faction) -->
      <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm stat-label" data-i18n-ui="calculator.momentum.title">Momentum &amp; faction passive</span>
          <span id="mom-faction-name" class="text-xs text-[var(--color-gold)] font-semibold">—</span>
        </div>
        <label class="label block mb-1.5" for="momentum" data-i18n-ui="calculator.momentum.value">Momentum</label>
        <input id="momentum" class="input" type="number" min="0" max="100" value="0" inputmode="numeric" />
        <div class="hud-bar mt-2"><span id="mom-bar-fill" class="fill mom" style="width:0%"></span><span id="mom-bar-label" class="label">0/100</span></div>
        <p id="mom-passive" class="text-sm font-semibold mt-2"></p>
        <ul id="mom-effects" class="text-xs text-[var(--color-muted)] mt-1.5 space-y-1"></ul>
        <p id="mom-notes" class="text-[0.7rem] text-[var(--color-faint)] mt-2"></p>
      </div>
    </section>

    <!-- Target -->
    <section class="surface p-5">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="common.target">Target</h2>
      <label class="label block mb-1.5" for="unit" data-i18n-ui="common.unit">Unit</label>
      <select id="unit" class="select mb-4"></select>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="label block mb-1.5" for="armor" data-i18n-ui="common.armor">Armor</label>
          <input id="armor" class="input" type="number" min="0" inputmode="numeric" value="0" />
        </div>
        <div>
          <label class="label block mb-1.5" for="evasion">Evasion</label>
          <input id="evasion" class="input" type="number" inputmode="numeric" value="0" />
        </div>
        <div>
          <label class="label block mb-1.5" for="hpmodel" data-i18n-ui="compare.row.healthPerModel">HP / model</label>
          <input id="hpmodel" class="input" type="number" min="1" inputmode="numeric" value="20" />
        </div>
        <div>
          <label class="label block mb-1.5" for="members" data-i18n-ui="common.models">Models</label>
          <input id="members" class="input" type="number" min="1" inputmode="numeric" value="1" />
        </div>
        <div>
          <label class="label block mb-1.5" for="curhp" data-i18n-ui="calculator.target.currentHp">Front model HP</label>
          <input id="curhp" class="input" type="number" min="0" inputmode="numeric" placeholder="full" data-i18n-ui-placeholder="calculator.target.fullHp" />
        </div>
        <div>
          <label class="label block mb-1.5" for="lost" data-i18n-ui="calculator.target.modelsLost">Models lost</label>
          <input id="lost" class="input" type="number" min="0" inputmode="numeric" value="0" />
        </div>
      </div>
    </section>

    <!-- Results -->
    <section class="surface p-5 lg:row-span-1 relative overflow-hidden">
      <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full blur-3xl opacity-20" style="background:radial-gradient(circle,var(--color-toxin),transparent 70%)"></div>
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="common.results">Results</h2>
      <div class="space-y-2.5 relative">
        <div class="flex items-baseline justify-between">
          <span class="text-sm stat-label" data-i18n-ui="calculator.result.hitChance">Hit chance</span>
          <span id="r-hit" class="text-2xl font-black tabular-nums">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm stat-label" data-i18n-ui="common.damage">Damage</span>
          <span id="r-perhit" class="text-2xl font-black text-[var(--color-gold)] tabular-nums whitespace-nowrap">—</span>
        </div>
        <div class="flex items-baseline justify-between pl-3">
          <span class="text-xs stat-sublabel" data-i18n-ui="calculator.result.damagePerAttack">Damage per attack</span>
          <span id="r-attack" class="text-lg font-bold tabular-nums text-[var(--color-ink)]">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm stat-label" data-i18n-ui="calculator.result.critChance">Critical chance</span>
          <span id="r-crit" class="text-lg font-bold tabular-nums text-[var(--color-gold)]">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm stat-label" data-i18n-ui="calculator.result.grazeChance">Graze chance</span>
          <span id="r-graze" class="text-lg font-bold tabular-nums text-[var(--color-momentum)]">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]" data-i18n-ui="calculator.result.expected">Expected (× hit %)</span>
          <span id="r-expected" class="text-lg font-bold tabular-nums text-[var(--color-ink)]">—</span>
        </div>
        <div class="border-t border-[var(--color-border)] my-3"></div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]" data-i18n-ui="calculator.result.modelsKilledRaw">Models killed (raw)</span>
          <span id="r-killed" class="text-xl font-bold tabular-nums text-[var(--color-hp)]">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]" data-i18n-ui="calculator.result.targetTotalHp">Target total HP</span>
          <span id="r-totalhp" class="text-xl font-bold tabular-nums text-[var(--color-ink)]">—</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-[var(--color-muted)]" data-i18n-ui="calculator.result.targetRemainingHp">Target remaining HP</span>
          <span id="r-remaining" class="text-xl font-black tabular-nums text-[var(--color-hp)]">—</span>
        </div>
        <p class="text-[0.7rem] text-[var(--color-faint)] pt-1" data-i18n-ui="calculator.result.assumptionNote">
          Damage is the in-game range (min = 75% of max). Crit/graze chances assume 1% per
          point of armor-vs-penetration difference — an estimate pending calibration.
        </p>
      </div>
      <button id="copy-link" type="button" class="btn w-full mt-5" data-url="" data-i18n-ui="common.copyShareableLink">
        Copy shareable link
      </button>
    </section>
  </div>

  <!-- Battlefield modifiers (real data: cover armor + buff presets + range info) -->
  <section class="surface p-5 mt-4">
    <h2 class="text-lg font-bold mb-1" data-i18n-ui="calculator.section.battlefield">Battlefield modifiers</h2>
    <p class="text-sm text-[var(--color-faint)] mb-4" data-i18n-ui="calculator.section.battlefieldNote">
      Cover applies the real ranged-armor bonus and buff presets use real in-game stat
      changes. Distance shows the weapon's real range; the exact accuracy penalty from
      cover/distance isn't applied because that formula lives in native game code.
    </p>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <label class="label block mb-1.5" for="cover" data-i18n-ui="calculator.adv.cover">Cover</label>
        <select id="cover" class="select">
          <option value="0" data-i18n-ui="calculator.cover.none">None</option>
          <option value="1" data-i18n-ui="calculator.cover.light">Light (+1 ranged armor)</option>
          <option value="2" data-i18n-ui="calculator.cover.heavy">Heavy (+2 ranged armor)</option>
        </select>
      </div>
      <div>
        <label class="label block mb-1.5" for="atk-buff" data-i18n-ui="calculator.buff.attacker">Attacker buff</label>
        <select id="atk-buff" class="select"></select>
      </div>
      <div>
        <label class="label block mb-1.5" for="tgt-buff" data-i18n-ui="calculator.buff.target">Target buff</label>
        <select id="tgt-buff" class="select"></select>
      </div>
      <div>
        <label class="label block mb-1.5" for="distance" data-i18n-ui="calculator.adv.distance">Tile distance</label>
        <input id="distance" class="input" type="number" min="0" inputmode="numeric" placeholder="—" />
      </div>
    </div>
    <p id="range-info" class="text-xs text-[var(--color-faint)] mt-3"></p>
  </section>
  </div>

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>

  <div id="mode-battle" class="hidden">
  <!-- Combat Simulator -->
  <section class="surface p-5 md:p-6 mt-6 relative overflow-hidden">
    <div class="absolute -top-20 -left-16 w-56 h-56 rounded-full blur-3xl opacity-20" style="background:radial-gradient(circle,var(--color-blood),transparent 70%)"></div>
    <div class="relative">
      <h2 class="text-xl font-black" data-i18n-ui="combatSim.title">Combat Simulator</h2>
      <p class="text-sm text-[var(--color-muted)] mt-1 mb-5 max-w-3xl" data-i18n-ui="combatSim.subtitle">
        Pit two squads against each other. Each dot is a model: the red bar is current
        health, blue is bonus HP (e.g. a Commissar's shield), and a dimmed dot is a
        casualty. Press play to auto-resolve the fight with dice rolls.
      </p>

      <div class="grid gap-4 md:grid-cols-2">
        <!-- Squad A -->
        <div class="rounded-xl border border-[var(--color-border)] p-4" style="border-left:3px solid var(--color-plasma)">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-bold" data-i18n-ui="combatSim.squadA">Squad A</h3>
            <span id="simA-count" class="text-xs text-[var(--color-faint)] tabular-nums"></span>
          </div>
          <div class="grid gap-2.5">
            <select id="simA-unit" class="select" aria-label="Squad A unit"></select>
            <select id="simA-weapon" class="select" aria-label="Squad A weapon"></select>
            <label class="label flex items-center justify-between gap-2 normal-case">
              <span data-i18n-ui="combatSim.bonusHp">Bonus HP / model</span>
              <input id="simA-bonus" class="input w-24" type="number" min="0" value="0" inputmode="numeric" />
            </label>
          </div>
          <div id="simA-field" class="flex flex-wrap gap-1.5 mt-4 min-h-[2.25rem]"></div>
        </div>
        <!-- Squad B -->
        <div class="rounded-xl border border-[var(--color-border)] p-4" style="border-left:3px solid var(--color-blood)">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-bold" data-i18n-ui="combatSim.squadB">Squad B</h3>
            <span id="simB-count" class="text-xs text-[var(--color-faint)] tabular-nums"></span>
          </div>
          <div class="grid gap-2.5">
            <select id="simB-unit" class="select" aria-label="Squad B unit"></select>
            <select id="simB-weapon" class="select" aria-label="Squad B weapon"></select>
            <label class="label flex items-center justify-between gap-2 normal-case">
              <span data-i18n-ui="combatSim.bonusHp">Bonus HP / model</span>
              <input id="simB-bonus" class="input w-24" type="number" min="0" value="0" inputmode="numeric" />
            </label>
          </div>
          <div id="simB-field" class="flex flex-wrap gap-1.5 mt-4 min-h-[2.25rem]"></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-5">
        <button id="sim-play" type="button" class="btn btn-primary min-w-[7rem]">
          <span id="sim-play-label" data-i18n-ui="combatSim.play">▶ Play</span>
        </button>
        <button id="sim-revert" type="button" class="btn">
          <span data-i18n-ui="combatSim.revert">↺ Revert</span>
        </button>
        <div class="ml-auto text-sm text-[var(--color-muted)]">
          <span data-i18n-ui="combatSim.turn">Turn</span>
          <span id="sim-turn" class="font-bold tabular-nums">0</span>
        </div>
      </div>
      <p id="sim-outcome" class="mt-3 font-semibold min-h-[1.5rem]"></p>
      <ol id="sim-log" class="mt-2 space-y-1 text-xs text-[var(--color-muted)] max-h-44 overflow-y-auto"></ol>
    </div>
  </section>
  </div>

  <style is:global>
    .sim-dot {
      position: relative;
      width: 20px;
      height: 30px;
      border-radius: 5px;
      overflow: hidden;
      background: var(--color-base);
      border: 1px solid var(--color-border);
      display: flex;
      flex-direction: column-reverse;
      transition: opacity 0.3s ease, filter 0.3s ease;
    }
    .sim-dot.dead {
      opacity: 0.22;
      filter: grayscale(1);
    }
    .sim-dot > .hp {
      width: 100%;
      background: linear-gradient(to top, #d63b35, #ff6b63);
      transition: height 0.35s ease;
    }
    .sim-dot > .bonus {
      width: 100%;
      background: linear-gradient(to top, #2f6fe0, #5fa3ff);
      transition: height 0.35s ease;
    }
  </style>

  <script>
    import { initCalculator } from '../scripts/calculator';
    import { initCombatSim } from '../scripts/combat-sim';
    initCalculator();
    initCombatSim();
  </script>
</Base>
