---
import Base from '../../layouts/Base.astro';
import { clamp, damageRange } from '../../lib/combat';
import {
  STAT_MAX,
  factionColor,
  getUnit,
  getWeapon,
  idFromSlug,
  unitSlug,
  units,
  weaponSlug,
} from '../../lib/data';
import { getFactionEmblem, getUnitPortrait, getWeaponTypeIcon } from '../../scripts/images';

export function getStaticPaths() {
  return units.map((u) => ({
    params: { id: unitSlug(u) },
    props: { unitId: u.id },
  }));
}

const { unitId } = Astro.props;
const unit = getUnit(unitId) ?? getUnit(idFromSlug(Astro.params.id));
if (!unit) {
  return Astro.redirect('/units');
}

const armor =
  unit.armorProfile === 1
    ? [
        { key: 'unitDetail.armor.front', label: 'Front', value: unit.armorFront },
        { key: 'unitDetail.armor.left', label: 'Left', value: unit.armorLeft },
        { key: 'unitDetail.armor.right', label: 'Right', value: unit.armorRight },
        { key: 'unitDetail.armor.rear', label: 'Rear', value: unit.armorRear },
      ]
    : null;

const defenseStats = [
  {
    key: 'common.totalHealth',
    label: 'Total Health',
    value: unit.totalHealth,
    hint: `${unit.maxHealth} × ${unit.members}`,
  },
  { key: 'common.healthPerModel', label: 'Health / model', value: unit.maxHealth },
  { key: 'common.models', label: 'Models', value: unit.members },
  { key: 'common.armor', label: 'Armor', value: unit.armorProfile === 1 ? '—' : unit.armor },
  { key: 'common.evasion', label: 'Evasion', value: unit.evasion },
];

const mobilityStats = [
  { key: 'common.movement', label: 'Movement', value: unit.maxMovementPoints },
  { key: 'common.actionPoints', label: 'Action Points', value: unit.maxActionPoints },
  { key: 'common.unitHeight', label: 'Unit Height', value: unit.unitHeight },
];

const combatStats = [
  {
    key: 'unitDetail.stat.meleeAccuracy',
    label: 'Melee Accuracy',
    value: unit.meleeAccuracy ? `${unit.meleeAccuracy}%` : '—',
  },
  {
    key: 'unitDetail.stat.rangedAccuracyMod',
    label: 'Ranged Acc. Mod',
    value: `${unit.rangedAccuracyModifier >= 0 ? '+' : ''}${unit.rangedAccuracyModifier}`,
  },
  { key: 'common.momentumPerKill', label: 'Momentum / kill', value: unit.momentumPerModelDeath },
];

const tags = [
  unit.campaignOnly ? { key: 'common.campaignOnly', label: 'Campaign only' } : null,
  unit.isLarge ? { key: 'common.large', label: 'Large' } : null,
  unit.canMeleeReact ? { key: 'unitDetail.tag.meleeReaction', label: 'Melee Reaction' } : null,
  unit.canFallback ? { key: 'unitDetail.tag.canFallBack', label: 'Can Fall Back' } : null,
].filter(Boolean) as { key: string; label: string }[];

const accent = factionColor(unit.factionName);
const portrait = getUnitPortrait(unit.name, unit.portrait);
const emblem = getFactionEmblem(unit.faction);
const heroImage = portrait ?? emblem;

const vitals = [
  {
    key: 'common.health',
    label: 'Health',
    value: unit.totalHealth,
    pct: clamp((unit.totalHealth / STAT_MAX.health) * 100, 0, 100),
    color: 'linear-gradient(180deg,var(--color-hp),var(--color-hp-dim))',
  },
  {
    key: 'common.armor',
    label: 'Armor',
    value: unit.armorProfile === 1 ? unit.armorFront : unit.armor,
    pct: clamp(
      ((unit.armorProfile === 1 ? unit.armorFront : unit.armor) / STAT_MAX.armor) * 100,
      0,
      100,
    ),
    color: 'linear-gradient(180deg,var(--color-shield),var(--color-momentum-dim))',
  },
  {
    key: 'common.evasion',
    label: 'Evasion',
    value: unit.evasion,
    pct: clamp((unit.evasion / STAT_MAX.evasion) * 100, 0, 100),
    color: 'linear-gradient(90deg,var(--color-gold-dim),var(--color-gold))',
  },
  {
    key: 'common.movement',
    label: 'Movement',
    value: unit.maxMovementPoints,
    pct: clamp((unit.maxMovementPoints / STAT_MAX.movement) * 100, 0, 100),
    color: 'linear-gradient(90deg,var(--color-gold-dim),var(--color-gold))',
  },
  {
    key: 'common.actionPoints',
    label: 'Action Points',
    value: unit.maxActionPoints,
    pct: clamp((unit.maxActionPoints / STAT_MAX.actionPoints) * 100, 0, 100),
    color: 'linear-gradient(90deg,var(--color-gold-dim),var(--color-gold))',
  },
];
---

<Base
  title={unit.name}
  description={`${unit.name} — ${unit.factionName} ${unit.roleName}. ${unit.totalHealth} HP, ${unit.armorProfile === 1 ? 'directional armor' : `armor ${unit.armor}`}, ${unit.maxMovementPoints} movement, ${unit.pointCost} points.`}
  path={`/units/${unitSlug(unit)}`}
  ogType="article"
>
  <nav class="text-sm text-[var(--color-faint)] mb-5">
    <a href="/units" class="hover:text-[var(--color-gold-dim)]" data-i18n-ui="nav.units">Units</a>
    <span class="mx-1.5">/</span>
    <span class="text-[var(--color-muted)]">{unit.factionName}</span>
  </nav>

  <!-- Header -->
  <div class="surface p-6 md:p-8 relative overflow-hidden">
    <div class="absolute -top-24 -right-20 w-72 h-72 rounded-full blur-3xl opacity-25 pointer-events-none" style={`background:radial-gradient(circle, ${accent}, transparent 70%)`}></div>
    <div class="absolute top-0 left-0 w-1.5 h-full" style={`background:${unit.roleColor}`}></div>
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">
      <div class="flex items-start gap-4 md:gap-5 min-w-0">
        {heroImage && (
          <img
            src={heroImage}
            alt=""
            width="112"
            height="112"
            loading="lazy"
            class={`shrink-0 rounded-xl object-contain border border-[var(--color-border)] bg-black/30 ${portrait ? 'w-24 h-24 md:w-28 md:h-28 p-1' : 'w-16 h-16 p-2.5'}`}
          />
        )}
        <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="chip" style={`color:${unit.roleColor}; border-color:${unit.roleColor}`} data-i18n-role={unit.role} data-i18n-fallback={unit.roleName}>{unit.roleName}</span>
          <span class="chip" data-i18n-faction={unit.faction} data-i18n-fallback={unit.factionName}>{unit.factionName}</span>
          <span class="chip">{unit.substanceName}</span>
          {tags.map((t) => <span class="chip" data-i18n-ui={t.key}>{t.label}</span>)}
        </div>
        <h1 class="text-3xl md:text-4xl font-black" data-i18n-unit={unit.id} data-i18n-fallback={unit.name}>{unit.name}</h1>
        <p class="mt-2 text-[var(--color-muted)]">
          <span class="text-2xl font-bold text-[var(--color-gold)]">{unit.pointCost}</span>
          <span class="text-sm" data-i18n-ui="common.requisitionPoints"> requisition points</span>
        </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="copy-link" type="button" class="btn" data-url={`/units/${unitSlug(unit)}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
          <span data-i18n-ui="common.copyLink">Copy link</span>
        </button>
        <button
          id="add-army"
          type="button"
          class="btn btn-primary"
          data-id={unit.id}
          data-name={unit.name}
          data-points={unit.pointCost}
          data-faction={unit.factionName}
        >
          <span data-i18n-ui="unitDetail.action.armyBuilder">+ Army Builder</span>
        </button>
        <a href={`/compare?ids=${unit.id}`} class="btn btn-ghost" data-i18n-ui="unitDetail.action.compare">Compare</a>
      </div>
    </div>
  </div>

  <!-- Vitals -->
  <section class="surface p-5 md:p-6 mt-4">
    <div class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-5">
      {vitals.map((v) => (
        <div>
          <div class="flex items-baseline justify-between mb-1.5">
            <span class="label" data-i18n-ui={v.key}>{v.label}</span>
            <span class="font-bold tabular-nums">{v.value}</span>
          </div>
          <div class="statbar"><span style={`width:${v.pct}%;background:${v.color}`}></span></div>
        </div>
      ))}
    </div>
    <div class="mt-5 pt-4 border-t border-[var(--color-border)]">
      <div class="flex items-baseline justify-between mb-2">
        <span class="label" data-i18n-ui="common.models">Models</span>
        <span class="text-sm text-[var(--color-muted)]">
          {unit.members} × {unit.maxHealth} HP = <span class="text-[var(--color-hp)] font-bold tabular-nums">{unit.totalHealth}</span>
        </span>
      </div>
      <div class="flex flex-wrap gap-1">
        {Array.from({ length: Math.min(unit.members, 40) }).map(() => (
          <div class="hud-bar !h-3.5 grow basis-8"><span class="fill hp" style="width:100%"></span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stat groups -->
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-4">
    <section class="surface p-5">
      <h2 class="label mb-3" data-i18n-ui="unitDetail.section.defense">Defense</h2>
      <dl class="space-y-2.5">
        {defenseStats.map((s) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-sm text-[var(--color-muted)]" data-i18n-ui={s.key}>{s.label}</dt>
            <dd class="font-bold tabular-nums">
              {s.value}
              {'hint' in s && s.hint && <span class="text-xs text-[var(--color-faint)] font-normal ml-1">({s.hint})</span>}
            </dd>
          </div>
        ))}
      </dl>
      {armor && (
        <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
          <p class="label mb-2" data-i18n-ui="unitDetail.section.directionalArmor">Directional Armor</p>
          <div class="grid grid-cols-4 gap-2 text-center">
            {armor.map((a) => (
              <div class="rounded-lg bg-[var(--color-base)] py-2">
                <p class="font-bold tabular-nums">{a.value}</p>
                <p class="text-[10px] text-[var(--color-faint)] uppercase" data-i18n-ui={a.key}>{a.label}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <section class="surface p-5">
      <h2 class="label mb-3" data-i18n-ui="unitDetail.section.mobility">Mobility</h2>
      <dl class="space-y-2.5">
        {mobilityStats.map((s) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-sm text-[var(--color-muted)]" data-i18n-ui={s.key}>{s.label}</dt>
            <dd class="font-bold tabular-nums">{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="surface p-5">
      <h2 class="label mb-3" data-i18n-ui="unitDetail.section.combat">Combat</h2>
      <dl class="space-y-2.5">
        {combatStats.map((s) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-sm text-[var(--color-muted)]" data-i18n-ui={s.key}>{s.label}</dt>
            <dd class="font-bold tabular-nums">{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>

  <!-- Weapon loadout -->
  {unit.weaponSlots.length > 0 && (
    <section class="surface p-5 md:p-6 mt-4">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="unitDetail.section.weaponLoadout">Weapon Loadout</h2>
      <div class="space-y-4">
        {unit.weaponSlots.map((slot, i) => (
          <div>
            <p class="label mb-2 flex items-center gap-2">
              <span><span data-i18n-ui="unitDetail.slotPrefix">Slot</span> {i + 1}</span>
              {slot.options.length > 1 && (
                <span class="text-[10px] font-semibold text-[var(--color-faint)] normal-case" data-i18n-ui="unitDetail.loadout.chooseOne">Choose one</span>
              )}
            </p>
            <div class="grid gap-2 sm:grid-cols-2">
              {slot.options.map((opt) => {
                const w = getWeapon(opt.weaponId);
                const typeIcon = w ? getWeaponTypeIcon(w.isMelee) : null;
                return (
                  <a
                    href={w ? `/weapons/${weaponSlug(w)}` : '#'}
                    class="flex items-center justify-between gap-3 rounded-lg bg-[var(--color-base)] border border-[var(--color-border)] px-3.5 py-2.5 hover:border-[var(--color-border-strong)] transition-colors"
                  >
                    <span class="flex items-center gap-2.5 min-w-0">
                      {typeIcon && (
                        <img src={typeIcon} alt="" width="22" height="22" loading="lazy" class="w-5 h-5 shrink-0 object-contain opacity-80" />
                      )}
                      <span class="min-w-0">
                        <span class="font-semibold text-sm truncate block" data-i18n-weapon={opt.weaponId} data-i18n-fallback={opt.name}>{opt.name}</span>
                        {w && (
                          <span class="text-xs text-[var(--color-faint)]">
                            {damageRange(w.damage).min}–{damageRange(w.damage).max} <span data-i18n-ui="common.damageShort">dmg</span>{w.numAttacks > 1 ? ` ×${w.numAttacks}` : ''} · {w.accuracy}% <span data-i18n-ui="common.accuracyShort">acc</span>
                          </span>
                        )}
                      </span>
                    </span>
                    <span class="flex items-center gap-2 shrink-0">
                      {opt.startsLocked && <span class="chip !py-0.5 !px-1.5 text-[10px]" data-i18n-ui="common.locked">Locked</span>}
                      {opt.pointCost > 0 && <span class="text-xs font-bold text-[var(--color-gold-dim)]">+{opt.pointCost}</span>}
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>

  <script>
    import { initUnitDetail } from '../../scripts/unit-detail';
    initUnitDetail();
  </script>
</Base>
