---
import AbilityCard from '../../components/AbilityCard.astro';
import FieldNotes from '../../components/FieldNotes.astro';
import StatHexagon from '../../components/StatHexagon.astro';
import Tooltip from '../../components/Tooltip.astro';
import UnitRail from '../../components/UnitRail.astro';
import WeaponStatZone from '../../components/WeaponStatZone.astro';
import Base from '../../layouts/Base.astro';
import { getFactionPassive, passiveEffectLines } from '../../lib/abilities';
import {
  factionColor,
  getUnit,
  getWeapon,
  idFromSlug,
  unitSlug,
  units,
  weaponSlug,
} from '../../lib/data';
import { UNIT_TAG_TOOLTIPS } from '../../lib/tag-tooltips';
import { getAbilities } from '../../lib/unit-abilities';
import { resolveWeaponType } from '../../lib/weapon-display';
import {
  getFactionEmblem,
  getStatIcon,
  getUnitPortrait,
  getWeaponPortrait,
  getWeaponTypeIcon,
} from '../../scripts/images';

export function getStaticPaths() {
  return units.map((u) => ({
    params: { id: unitSlug(u) },
    props: { unitId: u.id },
  }));
}

const { unitId } = Astro.props;
const unit = getUnit(unitId) ?? getUnit(idFromSlug(Astro.params.id));
if (!unit) {
  return Astro.redirect('/units');
}

const armor =
  unit.armorProfile === 1
    ? [
        { key: 'unitDetail.armor.front', label: 'Front', value: unit.armorFront },
        { key: 'unitDetail.armor.left', label: 'Left', value: unit.armorLeft },
        { key: 'unitDetail.armor.right', label: 'Right', value: unit.armorRight },
        { key: 'unitDetail.armor.rear', label: 'Rear', value: unit.armorRear },
      ]
    : null;

const defenseStats = [
  {
    key: 'common.totalHealth',
    label: 'Total Health',
    value: unit.totalHealth,
    hint: `${unit.maxHealth} × ${unit.members}`,
  },
  { key: 'common.healthPerModel', label: 'Health / model', value: unit.maxHealth },
  { key: 'common.models', label: 'Models', value: unit.members },
  { key: 'common.armor', label: 'Armor', value: unit.armorProfile === 1 ? '—' : unit.armor },
  { key: 'common.evasion', label: 'Evasion', value: unit.evasion },
];

const mobilityStats = [
  { key: 'common.movement', label: 'Movement', value: unit.maxMovementPoints },
  { key: 'common.actionPoints', label: 'Action Points', value: unit.maxActionPoints },
  {
    key: 'common.unitHeight',
    label: 'Unit Height',
    value: unit.unitHeight,
    tip: 'Model height, used for cover and line-of-sight: taller units can see and shoot over low cover, and cover effectiveness depends on the relative heights of shooter, cover and target.',
  },
];

const combatStats = [
  {
    key: 'unitDetail.stat.meleeAccuracy',
    label: 'Melee Accuracy',
    value: unit.meleeAccuracy ? `${unit.meleeAccuracy}%` : '—',
  },
  {
    key: 'unitDetail.stat.rangedAccuracyMod',
    label: 'Ranged Acc. Mod',
    value: `${unit.rangedAccuracyModifier >= 0 ? '+' : ''}${unit.rangedAccuracyModifier}`,
  },
  { key: 'common.momentumPerKill', label: 'Momentum / kill', value: unit.momentumPerModelDeath },
];

const tags = [
  unit.campaignOnly
    ? {
        key: 'common.campaignOnly',
        label: 'Campaign only',
        tip: UNIT_TAG_TOOLTIPS.campaignOnly,
      }
    : null,
  unit.isLarge
    ? {
        key: 'common.large',
        label: 'Large',
        tip: UNIT_TAG_TOOLTIPS.large,
      }
    : null,
  unit.canMeleeReact
    ? {
        key: 'unitDetail.tag.meleeReaction',
        label: 'Melee Reaction',
        tip: UNIT_TAG_TOOLTIPS.meleeReaction,
      }
    : null,
  unit.canFallback
    ? {
        key: 'unitDetail.tag.canFallBack',
        label: 'Can Fall Back',
        tip: UNIT_TAG_TOOLTIPS.fallback,
      }
    : null,
].filter(Boolean) as { key: string; label: string; tip: string }[];

const accent = factionColor(unit.factionName);
const portrait = getUnitPortrait(unit.name, unit.portrait);
const emblem = getFactionEmblem(unit.faction);
const heroImage = portrait ?? emblem;

// Faction momentum passive (verified). Shown first in the Abilities section.
const factionPassive = getFactionPassive(unit.faction);
const passiveLines = factionPassive ? passiveEffectLines(factionPassive) : [];
const passiveNote = factionPassive?.note ?? factionPassive?.conditional?.note ?? null;

// Unit-specific abilities (curated from ability-overrides.local JSON)
const unitAbilities = unit.abilityIds ? getAbilities(unit.abilityIds) : [];

const vitals = [
  {
    label: 'HP',
    value: unit.maxHealth,
    sub: unit.members > 1 ? `× ${unit.members}` : null,
    accent: '#39904B',
    stat: 'health',
  },
  {
    label: 'AP',
    value: unit.maxActionPoints,
    accent: '#8F5B36',
    stat: 'actionPoints',
  },
  {
    label: 'MP',
    value: unit.maxMovementPoints,
    accent: '#2662AA',
    stat: 'movement',
  },
  {
    label: 'Armor',
    value: unit.armorProfile === 1 ? unit.armorFront : unit.armor,
    accent: '#6299B8',
    stat: 'armor',
  },
  {
    label: 'Dodge',
    value: unit.evasion,
    accent: '#9F895A',
    stat: 'evasion',
  },
];
---

<Base
  title={unit.name}
  description={`${unit.name} — ${unit.factionName} ${unit.roleName}. ${unit.totalHealth} HP, ${unit.armorProfile === 1 ? 'directional armor' : `armor ${unit.armor}`}, ${unit.maxMovementPoints} movement, ${unit.pointCost} points.`}
  path={`/units/${unitSlug(unit)}`}
  ogType="article"
>
  <div class="lg:grid lg:grid-cols-[minmax(340px,380px)_1fr] lg:gap-5 lg:items-start" data-units-view="detail">
    <div class="units-rail-col hidden lg:block lg:sticky lg:top-4 lg:h-[calc(100dvh-2rem)]">
      <UnitRail currentSlug={unitSlug(unit)} />
    </div>
    <div class="units-detail-col min-w-0">
  <div class="flex items-center gap-3 mb-5">
    <button type="button" data-back="/units" class="btn btn-ghost btn-sm shrink-0 lg:!hidden" aria-label="Back to units">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      <span data-i18n-ui="common.back">Back</span>
    </button>
    <nav class="text-sm text-[var(--color-faint)] min-w-0 truncate">
      <a href="/units" class="hover:text-[var(--color-gold-dim)]" data-i18n-ui="nav.units">Units</a>
      <span class="mx-1.5">/</span>
      <span class="text-[var(--color-muted)]">{unit.factionName}</span>
    </nav>
  </div>

  <!-- Header -->
  <div class="surface p-6 md:p-8 relative overflow-hidden">
    <div class="absolute -top-24 -right-20 w-72 h-72 rounded-full blur-3xl opacity-25 pointer-events-none" style={`background:radial-gradient(circle, ${accent}, transparent 70%)`}></div>
    <div class="absolute top-0 left-0 w-1.5 h-full" style={`background:${unit.roleColor}`}></div>
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">
      <div class="flex items-start gap-4 md:gap-5 min-w-0">
        {heroImage && (
          <img
            src={heroImage}
            alt=""
            width="112"
            height="112"
            loading="lazy"
            class={`shrink-0 rounded-xl object-contain border border-[var(--color-border)] bg-black/30 ${portrait ? 'w-24 h-24 md:w-28 md:h-28 p-1' : 'w-16 h-16 p-2.5'}`}
          />
        )}
        <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="chip" style={`color:${unit.roleColor}; border-color:${unit.roleColor}`} data-i18n-role={unit.role} data-i18n-fallback={unit.roleName}>{unit.roleName}</span>
          <span class="chip" data-i18n-faction={unit.faction} data-i18n-fallback={unit.factionName}>{unit.factionName}</span>
          <span class="chip">{unit.substanceName}</span>
          {tags.map((t) => (
            <Tooltip text={t.tip}>
              <span class="chip" data-i18n-ui={t.key}>{t.label}</span>
            </Tooltip>
          ))}
        </div>
        <h1 class="text-3xl md:text-4xl font-black" data-i18n-unit={unit.id} data-i18n-fallback={unit.name}>{unit.name}</h1>
        <p class="mt-2 text-[var(--color-muted)]">
          <span class="text-2xl font-bold text-[var(--color-gold)]">{unit.pointCost}</span>
          <span class="text-sm" data-i18n-ui="common.requisitionPoints"> requisition points</span>
        </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="copy-link" type="button" class="btn" data-url={`/units/${unitSlug(unit)}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
          <span data-i18n-ui="common.copyLink">Copy link</span>
        </button>
        <button
          id="add-army"
          type="button"
          class="btn btn-primary"
          data-id={unit.id}
          data-name={unit.name}
          data-points={unit.pointCost}
          data-faction={unit.factionName}
        >
          <span data-i18n-ui="unitDetail.action.armyBuilder">+ Army Builder</span>
        </button>
        <a href={`/units?compare=1&ids=${unit.id}`} class="btn btn-ghost" data-i18n-ui="unitDetail.action.compare">Compare</a>
      </div>
    </div>
  </div>

  <!-- Vitals + Stat Index hexagon -->
  <div class="grid gap-4 mt-4 lg:grid-cols-[1fr_300px] items-start">
  <section class="surface p-5 md:p-6">
    <div class="grid gap-x-6 gap-y-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
      {vitals.map((v) => (
        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-base)] px-3 py-2.5 text-center">
          <div class="flex items-center justify-center gap-1.5">
            {getStatIcon(v.stat) && (
              <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" aria-hidden="true">
                <defs>
                  <mask id={`vital-mask-${v.stat}`} maskUnits="userSpaceOnUse" x="0" y="0" width="20" height="20">
                    <image href={getStatIcon(v.stat)!} x="0" y="0" width="20" height="20" preserveAspectRatio="xMidYMid meet" />
                  </mask>
                </defs>
                <rect x="0" y="0" width="20" height="20" fill={v.accent} mask={`url(#vital-mask-${v.stat})`} />
              </svg>
            )}
            <p class="label" style={`color:${v.accent}`}>{v.label}</p>
          </div>
          <p class="text-2xl font-black tabular-nums mt-1 leading-none whitespace-nowrap" style={`color:${v.accent}`}>{v.value}</p>
          {'sub' in v && v.sub && (
            <p class="text-[11px] text-[var(--color-faint)] tabular-nums mt-0.5 whitespace-nowrap">{v.sub}</p>
          )}
        </div>
      ))}
    </div>
    <div class="mt-5 pt-4 border-t border-[var(--color-border)]">
      <div class="flex items-baseline justify-between mb-2">
        <span class="label" data-i18n-ui="common.models">Models</span>
        <span class="text-sm text-[var(--color-muted)]">
          {unit.members} × {unit.maxHealth} HP = <span class="text-[var(--color-hp)] font-bold tabular-nums">{unit.totalHealth}</span>
        </span>
      </div>
      <div class="flex flex-wrap gap-1">
        {Array.from({ length: Math.min(unit.members, 40) }).map(() => (
          <div class="hud-bar !h-5 grow basis-10">
            <span class="fill hp" style="width:100%"></span>
            <span class="label">{unit.maxHealth}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
    <StatHexagon kind="unit" id={unit.id} />
  </div>

  <!-- Stat groups -->
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-4">
    <section class="surface p-5">
      <h2 class="label mb-3" data-i18n-ui="unitDetail.section.defense">Defense</h2>
      <dl class="space-y-2.5">
        {defenseStats.map((s) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-sm text-[var(--color-muted)]" data-i18n-ui={s.key}>{s.label}</dt>
            <dd class="font-bold tabular-nums">
              {s.value}
              {'hint' in s && s.hint && <span class="text-xs text-[var(--color-faint)] font-normal ml-1">({s.hint})</span>}
            </dd>
          </div>
        ))}
      </dl>
      {armor && (
        <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
          <p class="label mb-2" data-i18n-ui="unitDetail.section.directionalArmor">Directional Armor</p>
          <div class="grid grid-cols-4 gap-2 text-center">
            {armor.map((a) => (
              <div class="rounded-lg bg-[var(--color-base)] py-2">
                <p class="font-bold tabular-nums">{a.value}</p>
                <p class="text-[10px] text-[var(--color-faint)] uppercase" data-i18n-ui={a.key}>{a.label}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <section class="surface p-5">
      <h2 class="label mb-3" data-i18n-ui="unitDetail.section.mobility">Mobility</h2>
      <dl class="space-y-2.5">
        {mobilityStats.map((s) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-sm text-[var(--color-muted)]">
              {'tip' in s && s.tip ? (
                <Tooltip text={s.tip}>
                  <span class="underline decoration-dotted cursor-help" data-i18n-ui={s.key}>{s.label}</span>
                </Tooltip>
              ) : (
                <span data-i18n-ui={s.key}>{s.label}</span>
              )}
            </dt>
            <dd class="font-bold tabular-nums">{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="surface p-5">
      <h2 class="label mb-3" data-i18n-ui="unitDetail.section.combat">Combat</h2>
      <dl class="space-y-2.5">
        {combatStats.map((s) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-sm text-[var(--color-muted)]" data-i18n-ui={s.key}>{s.label}</dt>
            <dd class="font-bold tabular-nums">{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>

  <!-- Weapon loadout -->
  {unit.weaponSlots.length > 0 && (
    <section class="surface p-5 md:p-6 mt-4">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="unitDetail.section.weaponLoadout">Weapon Loadout</h2>
      <div class="space-y-4">
        {unit.weaponSlots.map((slot, i) => (
          <div>
            <p class="label mb-2 flex items-center gap-2">
              <span><span data-i18n-ui="unitDetail.slotPrefix">Slot</span> {i + 1}</span>
              {slot.options.length > 1 && (
                <span class="text-[10px] font-semibold text-[var(--color-faint)] normal-case" data-i18n-ui="unitDetail.loadout.chooseOne">Choose one</span>
              )}
            </p>
            <div class="grid gap-2 sm:grid-cols-2">
              {slot.options.map((opt) => {
                const w = getWeapon(opt.weaponId);
                const wIcon = w ? (getWeaponPortrait(w.icon) ?? getWeaponTypeIcon(resolveWeaponType(w))) : null;
                return (
                  <a
                    href={w ? `/weapons/${weaponSlug(w)}` : '#'}
                    class="block rounded-lg bg-[var(--color-base)] border border-[var(--color-border)] px-3.5 py-3 hover:border-[var(--color-border-strong)] transition-colors"
                  >
                    <span class="flex items-center justify-between gap-3">
                      <span class="flex items-center gap-2.5 min-w-0">
                        {wIcon && (
                          <img src={wIcon} alt="" width="28" height="28" loading="lazy" class="asset-icon w-7 h-7 shrink-0 object-contain rounded bg-black/30 border border-[var(--color-border)] p-0.5" />
                        )}
                        <span class="font-semibold text-sm" data-i18n-weapon={opt.weaponId} data-i18n-fallback={opt.name}>{opt.name}</span>
                      </span>
                      <span class="flex items-center gap-2 shrink-0">
                        {opt.startsLocked && <span class="chip !py-0.5 !px-1.5 text-[10px]" data-i18n-ui="common.locked">Locked</span>}
                        {opt.pointCost > 0 && <span class="text-xs font-bold text-[var(--color-gold-dim)]">+{opt.pointCost}</span>}
                      </span>
                    </span>
                    {w && (
                      <span class="block mt-2.5">
                        <WeaponStatZone weapon={w} meleeAccuracyFallback={unit.meleeAccuracy} compact />
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Abilities -->
  {(factionPassive || unitAbilities.length > 0) && (
    <section class="surface p-5 md:p-6 mt-4">
      <h2 class="text-lg font-bold mb-4" data-i18n-ui="unitDetail.section.abilities">Abilities</h2>
      
      {factionPassive && (
        <div class="rounded-lg bg-[var(--color-base)] border border-[var(--color-border)] p-4 mb-4">
          <div class="flex items-start gap-3">
            {emblem && (
              <img src={emblem} alt="" width="40" height="40" loading="lazy" class="asset-icon w-10 h-10 shrink-0 object-contain rounded bg-black/30 border border-[var(--color-border)] p-1" />
            )}
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-bold">{factionPassive.passive}</span>
                <span class="chip !py-0 !px-1.5 text-[9px] !text-[var(--color-gold-dim)]" data-i18n-ui="unitDetail.factionPassive">Faction passive</span>
              </div>
              {passiveLines.length > 0 && (
                <ul class="mt-1.5 text-sm text-[var(--color-muted)] space-y-0.5">
                  {passiveLines.map((line) => <li>{line}</li>)}
                </ul>
              )}
              {passiveNote && (
                <p class="mt-1.5 text-xs text-[var(--color-faint)]">{passiveNote}</p>
              )}
            </div>
          </div>
        </div>
      )}

      {unitAbilities.length > 0 && (
        <div class="grid gap-3 sm:grid-cols-2">
          {unitAbilities.map((ability) => (
            <AbilityCard {...ability} />
          ))}
        </div>
      )}
    </section>
  )}

  {unit.notes && (
    <section class="mt-4">
      <FieldNotes note={unit.notes} />
    </section>
  )}

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden surface px-4 py-2.5 text-sm font-semibold z-[120]"></div>
    </div>
  </div>

  <script>
    import { initUnitDetail } from '../../scripts/unit-detail';
    import { initUnitsBrowser } from '../../scripts/units';
    import { initCompareMode } from '../../scripts/compare-mode';
    import { onPageLoad } from '../../scripts/reinit';
    onPageLoad(initUnitDetail);
    onPageLoad(initUnitsBrowser);
    onPageLoad(initCompareMode);
  </script>
</Base>
