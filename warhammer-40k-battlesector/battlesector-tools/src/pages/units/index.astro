---
import Base from '../../layouts/Base.astro';
import { factionColor, roles, unitSlug, units } from '../../lib/data';

const factionNames = [...new Set(units.map((u) => u.factionName))].sort();
const roleNames = [...roles]
  .sort((a, b) => a.sort - b.sort)
  .map((r) => r.name)
  .filter((n) => units.some((u) => u.roleName === n));

const sorted = [...units].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="Unit Database"
  description="Browse all 190 Warhammer 40,000: Battlesector units with full stats. Filter by faction, role and points."
  path="/units"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.database">Database</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.units">Units</h1>
    <p class="mt-2 text-[var(--color-muted)]" data-i18n-ui="units.header.subtitle">
      Browse unit stats, roles, and wargear to plan your next deployment.
    </p>
  </header>

  <!-- Controls -->
  <div class="surface p-4 mb-6 sticky top-[4.5rem] z-30">
    <div class="grid gap-3 md:grid-cols-[1fr_auto_auto_auto] md:items-end">
      <div>
        <label class="label block mb-1.5" for="q" data-i18n-ui="common.search">Search</label>
        <input id="q" class="input" type="search" placeholder="Search by name…" data-i18n-ui-placeholder="common.searchPlaceholder" autocomplete="off" />
      </div>
      <div>
        <label class="label block mb-1.5" for="faction" data-i18n-ui="common.faction">Faction</label>
        <select id="faction" class="select min-w-[10rem]">
          <option value="" data-i18n-ui="units.filter.allFactions">All factions</option>
          {factionNames.map((f) => {
            const sample = units.find((u) => u.factionName === f);
            return (
              <option value={f} data-faction-id={sample?.faction ?? ''}>
                {f}
              </option>
            );
          })}
        </select>
      </div>
      <div>
        <label class="label block mb-1.5" for="role" data-i18n-ui="common.role">Role</label>
        <select id="role" class="select min-w-[9rem]">
          <option value="" data-i18n-ui="units.filter.allRoles">All roles</option>
          {roleNames.map((r) => {
            const sample = units.find((u) => u.roleName === r);
            return (
              <option value={r} data-role-id={sample?.role ?? ''}>
                {r}
              </option>
            );
          })}
        </select>
      </div>
      <div>
        <label class="label block mb-1.5" for="sort" data-i18n-ui="common.sort">Sort</label>
        <select id="sort" class="select min-w-[10rem]">
          <option value="name" data-i18n-ui="units.sort.name">Name (A–Z)</option>
          <option value="points-desc" data-i18n-ui="units.sort.pointsDesc">Points (high→low)</option>
          <option value="points-asc" data-i18n-ui="units.sort.pointsAsc">Points (low→high)</option>
          <option value="hp-desc" data-i18n-ui="units.sort.hpDesc">Health (high→low)</option>
          <option value="armor-desc" data-i18n-ui="units.sort.armorDesc">Armor (high→low)</option>
          <option value="move-desc" data-i18n-ui="units.sort.moveDesc">Movement (high→low)</option>
        </select>
      </div>
    </div>
    <div class="mt-3 flex items-center justify-between">
      <p id="count" class="text-sm text-[var(--color-faint)]"></p>
      <button id="reset" type="button" class="text-sm font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]" data-i18n-ui="common.resetFilters">Reset filters</button>
    </div>
  </div>

  <!-- Grid -->
  <div id="grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map((u) => (
      <a
        href={`/units/${unitSlug(u)}`}
        class="unit-card surface surface-hover p-4 block"
        data-name={u.name.toLowerCase()}
        data-id={u.id}
        data-faction-id={u.faction}
        data-role-id={u.role}
        data-faction={u.factionName}
        data-role={u.roleName}
        data-points={u.pointCost}
        data-hp={u.totalHealth}
        data-armor={u.armor}
        data-move={u.maxMovementPoints}
      >
        <div class="flex items-start gap-3">
          <span class="w-1 self-stretch rounded-full shrink-0" style={`background:${u.roleColor}`}></span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <h3 class="font-bold truncate" data-i18n-unit={u.id} data-i18n-fallback={u.name}>{u.name}</h3>
              {u.isLarge && <span class="chip !py-0.5 !px-1.5 text-[10px]" data-i18n-ui="common.large">Large</span>}
            </div>
            <p class="text-xs text-[var(--color-faint)] mt-0.5 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${factionColor(u.factionName)}`}></span>
              <span data-i18n-faction={u.faction} data-i18n-fallback={u.factionName}>{u.factionName}</span> · <span data-i18n-role={u.role} data-i18n-fallback={u.roleName}>{u.roleName}</span>
            </p>
          </div>
          <div class="text-right shrink-0">
            <p class="font-bold text-[var(--color-gold)] leading-none">{u.pointCost}</p>
            <p class="text-[10px] text-[var(--color-faint)] uppercase tracking-wide mt-1" data-i18n-ui="common.pointsShort">pts</p>
          </div>
        </div>
        <div class="grid grid-cols-4 gap-2 mt-4 text-center">
          <div>
            <p class="text-sm font-bold">{u.totalHealth}</p>
            <p class="text-[10px] text-[var(--color-faint)] uppercase" data-i18n-ui="common.hpShort">HP</p>
          </div>
          <div>
            <p class="text-sm font-bold">{u.armor}</p>
            <p class="text-[10px] text-[var(--color-faint)] uppercase" data-i18n-ui="common.armor">Armor</p>
          </div>
          <div>
            <p class="text-sm font-bold">{u.maxMovementPoints}</p>
            <p class="text-[10px] text-[var(--color-faint)] uppercase" data-i18n-ui="common.moveShort">Move</p>
          </div>
          <div>
            <p class="text-sm font-bold">{u.maxActionPoints}</p>
            <p class="text-[10px] text-[var(--color-faint)] uppercase" data-i18n-ui="common.apShort">AP</p>
          </div>
        </div>
      </a>
    ))}
  </div>

  <p id="empty" class="hidden text-center text-[var(--color-faint)] py-16" data-i18n-ui="units.empty.noMatches">
    No units match your filters.
  </p>

  <script>
    import { initUnitsBrowser } from '../../scripts/units';
    initUnitsBrowser();
  </script>
</Base>
