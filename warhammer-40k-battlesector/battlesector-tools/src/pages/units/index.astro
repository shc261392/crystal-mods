---
import UnitSplitCard from '../../components/UnitSplitCard.astro';
import UnitFilterFields from '../../components/filters/UnitFilterFields.astro';
import Base from '../../layouts/Base.astro';
import { factions, unitSlug, units } from '../../lib/data';
import { getFactionEmblem } from '../../scripts/images';

// Faction buttons ordered by in-game faction id: Blood Angels (0) leftmost,
// Ultramarines (11) rightmost. Only factions that actually field units appear.
const factionButtons = factions
  .filter((f) => units.some((u) => u.faction === f.id))
  .sort((a, b) => a.id - b.id);

function tierRank(roleName: string): number {
  if (roleName === 'HQ') return 0;
  if (roleName === 'Elite') return 1;
  if (roleName === 'Heavy Support') return 2;
  if (roleName === 'Fast Attack' || roleName === 'Flyer') return 3;
  if (roleName === 'Troop') return 4;
  return 99;
}

const sorted = [...units].sort(
  (a, b) => tierRank(a.roleName) - tierRank(b.roleName) || a.name.localeCompare(b.name),
);
---

<Base
  title="Unit Database"
  description="Browse all 190 Warhammer 40,000: Battlesector units with full stats. Filter by faction, role and points."
  path="/units"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.database">Database</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.units">Units</h1>
  </header>

  <!-- Controls -->
  <div class="surface p-3 md:p-4 mb-6 relative md:sticky md:top-[4.5rem] md:z-30">
    <!-- Faction bar: all factions visible, wraps onto multiple rows (no scroll). -->
    <div id="faction-bar" class="flex flex-wrap gap-1.5 mb-2 md:mb-3" role="tablist" aria-label="Faction">
      <button
        type="button"
        class="faction-btn shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs md:text-sm font-semibold border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:border-[var(--color-border-strong)] whitespace-nowrap transition-colors"
        data-faction=""
        data-faction-id=""
        role="tab"
      >
        All factions
      </button>
      {factionButtons.map((f) => (
        <button
          type="button"
          class="faction-btn shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs md:text-sm font-semibold border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:border-[var(--color-border-strong)] whitespace-nowrap transition-colors"
          data-faction={f.name}
          data-faction-id={f.id}
          role="tab"
        >
          {getFactionEmblem(f.id) && (
            <img src={getFactionEmblem(f.id)} alt="" width="16" height="16" loading="lazy" class="w-3.5 h-3.5 object-contain shrink-0" />
          )}
          <span data-i18n-faction={f.id} data-i18n-fallback={f.name}>{f.name}</span>
        </button>
      ))}
    </div>

    <!-- Search + mobile filter toggle -->
    <div class="flex items-end gap-2">
      <div class="flex-1 min-w-0">
        <label class="label mb-1.5 sr-only md:not-sr-only md:block" for="q" data-i18n-ui="common.search">Search</label>
        <input id="q" class="input" type="search" placeholder="Search by name…" data-i18n-ui-placeholder="common.searchPlaceholder" autocomplete="off" />
      </div>
      <button
        id="filters-toggle"
        type="button"
        class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-semibold border border-[var(--color-border)] text-[var(--color-ink)] hover:border-[var(--color-border-strong)] transition-colors"
        aria-expanded="false"
        aria-controls="filters-body"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        <span data-i18n-ui="common.filters">Filters</span>
        <span id="filters-count-badge" class="hidden min-w-[1.25rem] h-5 px-1 inline-flex items-center justify-center rounded-full bg-[var(--color-gold)] text-[var(--color-void)] text-[11px] font-bold tabular-nums"></span>
      </button>
    </div>

    <!-- Collapsible filter body. On mobile it floats as a dropdown overlay so
         the persistent controls (faction bar + search) stay under ~1/5 of the
         viewport; on md+ it expands inline. -->
    <div id="filters-body" class="hidden absolute left-0 right-0 top-full z-40 mt-1 p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xl max-h-[62vh] overflow-y-auto md:static md:z-auto md:mt-0 md:p-0 md:border-0 md:bg-transparent md:shadow-none md:max-h-none md:overflow-visible md:rounded-none">
      <div class="mt-0 md:mt-3">
        <UnitFilterFields roleId="role" sortId="sort" campaignId="show-campaign-units-browser" tagFilterId="unit-tag-filter" />
      </div>
    </div>

    <div class="mt-3 flex items-center justify-between">
      <p id="count" class="text-sm text-[var(--color-faint)]"></p>
      <button id="reset" type="button" class="text-sm font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]" data-i18n-ui="common.resetFilters">Reset filters</button>
    </div>
  </div>

  <!-- Grid -->
  <div id="grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map((u) => {
      return (
        <UnitSplitCard
          unit={u}
          variant="tall"
          href={`/units/${unitSlug(u)}`}
          armyAdd
          dataAttrs={{
            'data-name': u.name.toLowerCase(),
            'data-id': u.id,
            'data-faction-id': u.faction,
            'data-role-id': u.role,
            'data-faction': u.factionName,
            'data-role': u.roleName,
            'data-tier-rank': tierRank(u.roleName),
            'data-points': u.pointCost,
            'data-hp': u.totalHealth,
            'data-armor': u.armor,
            'data-move': u.maxMovementPoints,
            'data-tags': [
              u.roleName === 'HQ' ? 'hq' : null,
              u.isLarge ? 'large' : null,
              u.campaignOnly ? 'campaign' : null,
              u.canMeleeReact ? 'melee-reaction' : null,
              u.canFallback ? 'fallback' : null,
            ]
              .filter(Boolean)
              .join(','),
          }}
        />
      );
    })}
  </div>

  <p id="empty" class="hidden text-center text-[var(--color-faint)] py-16" data-i18n-ui="units.empty.noMatches">
    No units match your filters.
  </p>

  <script>
    import { initUnitsBrowser } from '../../scripts/units';
    import { onPageLoad } from '../../scripts/reinit';
    onPageLoad(initUnitsBrowser);
  </script>
</Base>

<style>
  /* Slim, unobtrusive scrollbar for the swipeable faction bar on mobile. */
  .filter-scroll {
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .filter-scroll::-webkit-scrollbar {
    height: 4px;
  }
  .filter-scroll::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: 9999px;
  }
</style>
