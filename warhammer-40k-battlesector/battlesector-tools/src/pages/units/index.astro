---
import UnitRail from '../../components/UnitRail.astro';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Unit Database"
  description="Browse all 190 Warhammer 40,000: Battlesector units with full stats. Filter by faction, role and points."
  path="/units"
>
  <div class="lg:grid lg:grid-cols-[minmax(340px,380px)_1fr] lg:gap-5 lg:items-start" data-units-view="index">
    <div class="units-rail-col lg:sticky lg:top-4 lg:h-[calc(100dvh-2rem)]">
      <UnitRail />
    </div>
    <div class="units-detail-col hidden lg:block">
      <div data-compare-prompt class="surface grid place-items-center min-h-[70vh] text-center p-8">
        <div>
          <p class="eyebrow mb-2" data-i18n-ui="nav.units">Units</p>
          <p class="text-lg font-semibold text-[var(--color-muted)]" data-i18n-ui="units.selectPrompt">Select a unit to view its full stats.</p>
        </div>
      </div>
      <div data-compare-panel class="hidden"></div>
    </div>
  </div>

  <script>
    import { initUnitsBrowser } from '../../scripts/units';
    import { initCompareMode } from '../../scripts/compare-mode';
    import { onPageLoad } from '../../scripts/reinit';
    onPageLoad(initUnitsBrowser);
    onPageLoad(initCompareMode);
  </script>
</Base>

<style>
  .filter-scroll {
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .filter-scroll::-webkit-scrollbar {
    height: 4px;
  }
  .filter-scroll::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: 9999px;
  }
</style>
