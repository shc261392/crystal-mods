---
import Base from '../../layouts/Base.astro';
import Tooltip from '../../components/Tooltip.astro';
import UnitSplitCard from '../../components/UnitSplitCard.astro';
import { factions, roles, unitSlug, units } from '../../lib/data';
import { UNIT_TAG_TOOLTIPS } from '../../lib/tag-tooltips';
import { getFactionEmblem } from '../../scripts/images';

// Faction buttons ordered by in-game faction id: Blood Angels (0) leftmost,
// Ultramarines (11) rightmost. Only factions that actually field units appear.
const factionButtons = factions
  .filter((f) => units.some((u) => u.faction === f.id))
  .sort((a, b) => a.id - b.id);
const roleNames = [...roles]
  .sort((a, b) => a.sort - b.sort)
  .map((r) => r.name)
  .filter((n) => units.some((u) => u.roleName === n));

function tierRank(roleName: string): number {
  if (roleName === 'HQ') return 0;
  if (roleName === 'Elite') return 1;
  if (roleName === 'Heavy Support') return 2;
  if (roleName === 'Fast Attack' || roleName === 'Flyer') return 3;
  if (roleName === 'Troop') return 4;
  return 99;
}

const sorted = [...units].sort(
  (a, b) => tierRank(a.roleName) - tierRank(b.roleName) || a.name.localeCompare(b.name),
);

---

<Base
  title="Unit Database"
  description="Browse all 190 Warhammer 40,000: Battlesector units with full stats. Filter by faction, role and points."
  path="/units"
>
  <header class="mb-6">
    <p class="eyebrow mb-2" data-i18n-ui="common.database">Database</p>
    <h1 class="text-3xl md:text-4xl font-black" data-i18n-ui="nav.units">Units</h1>
    <p class="mt-2 text-[var(--color-muted)]" data-i18n-ui="units.header.subtitle">
      Browse unit stats, roles, and wargear to plan your next deployment.
    </p>
  </header>

  <!-- Controls -->
  <div class="surface p-4 mb-6 sticky top-[4.5rem] z-30">
    <div id="faction-bar" class="flex flex-wrap gap-1.5 pb-1.5 mb-3" role="tablist" aria-label="Faction">
      <button
        type="button"
        class="faction-btn shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:border-[var(--color-border-strong)] whitespace-nowrap transition-colors"
        data-faction=""
        data-faction-id=""
        role="tab"
      >
        All factions
      </button>
      {factionButtons.map((f) => (
        <button
          type="button"
          class="faction-btn shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:border-[var(--color-border-strong)] whitespace-nowrap transition-colors"
          data-faction={f.name}
          data-faction-id={f.id}
          role="tab"
        >
          {getFactionEmblem(f.id) && (
            <img src={getFactionEmblem(f.id)} alt="" width="16" height="16" loading="lazy" class="w-4 h-4 object-contain shrink-0" />
          )}
          <span data-i18n-faction={f.id} data-i18n-fallback={f.name}>{f.name}</span>
        </button>
      ))}
    </div>
    <div class="grid gap-3 md:grid-cols-[1fr_auto_auto] md:items-end">
      <div>
        <label class="label block mb-1.5" for="q" data-i18n-ui="common.search">Search</label>
        <input id="q" class="input" type="search" placeholder="Search by name…" data-i18n-ui-placeholder="common.searchPlaceholder" autocomplete="off" />
      </div>
      <div>
        <label class="label block mb-1.5" for="role" data-i18n-ui="common.role">Role</label>
        <select id="role" class="select min-w-[9rem]">
          <option value="" data-i18n-ui="units.filter.allRoles">All roles</option>
          {roleNames.map((r) => {
            const sample = units.find((u) => u.roleName === r);
            return (
              <option value={r} data-role-id={sample?.role ?? ''}>
                {r}
              </option>
            );
          })}
        </select>
      </div>
      <div>
        <label class="label block mb-1.5" for="sort" data-i18n-ui="common.sort">Sort</label>
        <select id="sort" class="select min-w-[10rem]">
          <option value="tier-name">Tier (HQ→Troop), Name (A–Z)</option>
          <option value="name" data-i18n-ui="units.sort.name">Name (A–Z)</option>
          <option value="name-desc">Name (Z–A)</option>
          <option value="points-desc" data-i18n-ui="units.sort.pointsDesc">Points (high→low)</option>
          <option value="points-asc" data-i18n-ui="units.sort.pointsAsc">Points (low→high)</option>
          <option value="hp-desc" data-i18n-ui="units.sort.hpDesc">Health (high→low)</option>
          <option value="hp-asc">Health (low→high)</option>
          <option value="armor-desc" data-i18n-ui="units.sort.armorDesc">Armor (high→low)</option>
          <option value="armor-asc">Armor (low→high)</option>
          <option value="move-desc" data-i18n-ui="units.sort.moveDesc">Movement (high→low)</option>
          <option value="move-asc">Movement (low→high)</option>
        </select>
      </div>
    </div>
    <div class="mt-3">
      <p class="label mb-1.5">Tags</p>
      <div id="unit-tag-filter" class="flex flex-wrap gap-2">
        <button type="button" class="chip cursor-pointer" data-tag="hq">
          <Tooltip text={UNIT_TAG_TOOLTIPS.hq}><span>HQ</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="large">
          <Tooltip text={UNIT_TAG_TOOLTIPS.large}><span data-i18n-ui="common.large">Large</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="campaign">
          <Tooltip text={UNIT_TAG_TOOLTIPS.campaignOnly}><span data-i18n-ui="common.campaignOnly">Campaign only</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="melee-reaction">
          <Tooltip text={UNIT_TAG_TOOLTIPS.meleeReaction}><span data-i18n-ui="unitDetail.tag.meleeReaction">Melee Reaction</span></Tooltip>
        </button>
        <button type="button" class="chip cursor-pointer" data-tag="fallback">
          <Tooltip text={UNIT_TAG_TOOLTIPS.fallback}><span data-i18n-ui="unitDetail.tag.canFallBack">Can Fall Back</span></Tooltip>
        </button>
      </div>
    </div>
    <div class="mt-3 flex items-center justify-between">
      <p id="count" class="text-sm text-[var(--color-faint)]"></p>
      <button id="reset" type="button" class="text-sm font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]" data-i18n-ui="common.resetFilters">Reset filters</button>
    </div>
  </div>

  <!-- Grid -->
  <div id="grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map((u) => {
      return (
        <UnitSplitCard
          unit={u}
          href={`/units/${unitSlug(u)}`}
          dataAttrs={{
            'data-name': u.name.toLowerCase(),
            'data-id': u.id,
            'data-faction-id': u.faction,
            'data-role-id': u.role,
            'data-faction': u.factionName,
            'data-role': u.roleName,
            'data-tier-rank': tierRank(u.roleName),
            'data-points': u.pointCost,
            'data-hp': u.totalHealth,
            'data-armor': u.armor,
            'data-move': u.maxMovementPoints,
            'data-tags': [
              u.roleName === 'HQ' ? 'hq' : null,
              u.isLarge ? 'large' : null,
              u.campaignOnly ? 'campaign' : null,
              u.canMeleeReact ? 'melee-reaction' : null,
              u.canFallback ? 'fallback' : null,
            ]
              .filter(Boolean)
              .join(','),
          }}
        />
      );
    })}
  </div>

  <p id="empty" class="hidden text-center text-[var(--color-faint)] py-16" data-i18n-ui="units.empty.noMatches">
    No units match your filters.
  </p>

  <script>
    import { initUnitsBrowser } from '../../scripts/units';
    initUnitsBrowser();
  </script>
</Base>
