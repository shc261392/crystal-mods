---
// The standalone comparison tool has moved into the Units page (Compare mode).
// This route now redirects, preserving any shared ?ids= selection.
import Base from '../layouts/Base.astro';
---

<Base
  title="Unit Comparison"
  description="Compare Warhammer 40,000: Battlesector units side by side, now built into the Units page."
  path="/compare"
>
  <div class="surface p-12 text-center text-[var(--color-faint)]">
    <p data-i18n-ui="compare.redirecting">Redirecting to the Units page…</p>
    <p class="mt-2"><a href="/units?compare=1" class="text-[var(--color-gold-dim)] hover:text-[var(--color-gold)] font-semibold" data-i18n-ui="nav.units">Units</a></p>
  </div>

  <script>
    const params = new URLSearchParams(location.search);
    const ids = params.get('ids');
    const target = `/units?compare=1${ids ? `&ids=${encodeURIComponent(ids)}` : ''}`;
    location.replace(target);
  </script>
</Base>

