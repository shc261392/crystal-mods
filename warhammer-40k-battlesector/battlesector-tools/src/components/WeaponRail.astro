---
import { weaponSlug, weapons } from '../lib/data';
import { WEAPON_TAG_TOOLTIPS } from '../lib/tag-tooltips';
import type { Weapon } from '../lib/types';
import { resolveWeaponType } from '../lib/weapon-display';
import Tooltip from './Tooltip.astro';
import WeaponListRow from './WeaponListRow.astro';

interface Props {
  /** Slug of the currently-open weapon (for selection highlight), if any. */
  currentSlug?: string;
}
const { currentSlug } = Astro.props as Props;

const sorted = [...weapons].sort((a, b) => a.name.localeCompare(b.name));

function rowAttrs(w: Weapon): Record<string, string | number> {
  const hits = w.numAttacks * Math.max(1, w.shotsPerAttack || 1);
  const tags = [
    resolveWeaponType(w),
    w.pistol ? 'pistol' : null,
    w.impactType === 'splash' ? 'splash' : null,
    w.impactType === 'tile' ? 'tile' : null,
    w.armorPiercing > 0 ? 'ap' : null,
  ]
    .filter(Boolean)
    .join(',');
  return {
    'data-name': w.name.toLowerCase(),
    'data-id': w.id,
    'data-damage': w.damage,
    'data-acc': w.accuracy,
    'data-ap': w.armorPiercing,
    'data-hits': hits,
    'data-tags': tags,
  };
}
---

<div class="flex flex-col lg:h-full" transition:persist="weapons-rail" data-weapons-rail>
  <!-- Controls -->
  <div class="surface p-3 shrink-0 relative">
    <div class="flex items-end gap-2">
      <div class="flex-1 min-w-0">
        <label class="label mb-1.5 sr-only" for="q" data-i18n-ui="common.search">Search</label>
        <input id="q" class="input" type="search" placeholder="Search by name…" data-i18n-ui-placeholder="common.searchPlaceholder" autocomplete="off" />
      </div>
      <button id="filters-toggle" type="button" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-semibold border border-[var(--color-border)] text-[var(--color-ink)] hover:border-[var(--color-border-strong)] transition-colors" aria-expanded="false" aria-controls="filters-body">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        <span data-i18n-ui="common.filters">Filters</span>
        <span id="filters-count-badge" class="hidden min-w-[1.25rem] h-5 px-1 inline-flex items-center justify-center rounded-full bg-[var(--color-gold)] text-[var(--color-void)] text-[11px] font-bold tabular-nums"></span>
      </button>
    </div>

    <div id="filters-body" class="hidden mt-2.5 pt-3 border-t border-[var(--color-border)]">
      <div>
        <label class="label block mb-1.5" for="sort" data-i18n-ui="common.sort">Sort</label>
        <select id="sort" class="select w-full">
          <option value="name" data-i18n-ui="weapons.sort.name">Name (A–Z)</option>
          <option value="damage-desc" data-i18n-ui="weapons.sort.damageDesc">Damage (high→low)</option>
          <option value="damage-asc" data-i18n-ui="weapons.sort.damageAsc">Damage (low→high)</option>
          <option value="acc-desc" data-i18n-ui="weapons.sort.accDesc">Accuracy (high→low)</option>
          <option value="acc-asc">Accuracy (low→high)</option>
          <option value="ap-desc">AP (high→low)</option>
          <option value="ap-asc">AP (low→high)</option>
          <option value="hits-desc">Hits (high→low)</option>
          <option value="hits-asc">Hits (low→high)</option>
        </select>
      </div>
      <div class="mt-3">
        <p class="label mb-1.5" data-i18n-ui="common.tags">Tags</p>
        <div id="weapon-tag-filter" class="flex flex-wrap gap-2">
          <button type="button" class="chip cursor-pointer" data-tag="melee">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.melee}><span data-i18n-ui="common.melee">Melee</span></Tooltip>
          </button>
          <button type="button" class="chip cursor-pointer" data-tag="ballistic">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.ballistic}><span data-i18n-ui="common.ballistic">Ballistic</span></Tooltip>
          </button>
          <button type="button" class="chip cursor-pointer" data-tag="flame">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.flame}><span data-i18n-ui="common.flame">Flame</span></Tooltip>
          </button>
          <button type="button" class="chip cursor-pointer" data-tag="artillery">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.artillery}><span data-i18n-ui="common.artillery">Artillery</span></Tooltip>
          </button>
          <button type="button" class="chip cursor-pointer" data-tag="pistol">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.pistol}><span data-i18n-ui="common.pistol">Pistol</span></Tooltip>
          </button>
          <button type="button" class="chip cursor-pointer" data-tag="splash">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.splash}><span data-i18n-ui="common.splash">Splash</span></Tooltip>
          </button>
          <button type="button" class="chip cursor-pointer" data-tag="tile">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.tile}><span>Tile-hit</span></Tooltip>
          </button>
          <button type="button" class="chip cursor-pointer" data-tag="ap">
            <Tooltip text={WEAPON_TAG_TOOLTIPS.ap}><span>AP</span></Tooltip>
          </button>
        </div>
      </div>
    </div>

    <div class="mt-2 flex items-center justify-between gap-2.5 min-w-0">
      <p id="count" class="text-xs text-[var(--color-faint)] truncate"></p>
      <div class="flex items-center gap-2.5 shrink-0">
        <button id="copy-filters" type="button" class="text-xs font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]" data-i18n-ui="common.copyLink">Copy link</button>
        <button id="reset" type="button" class="text-xs font-semibold text-[var(--color-gold-dim)] hover:text-[var(--color-gold)]" data-i18n-ui="common.resetFilters">Reset filters</button>
      </div>
    </div>
  </div>

  <!-- Scrollable list -->
  <div id="grid" class="flex flex-col gap-1 mt-2 lg:overflow-y-auto lg:flex-1 lg:min-h-0 pr-0.5">
    {sorted.map((w) => (
      <WeaponListRow weapon={w} href={`/weapons/${weaponSlug(w)}`} current={weaponSlug(w) === currentSlug} dataAttrs={rowAttrs(w)} />
    ))}
  </div>
  <p id="empty" class="hidden text-center text-[var(--color-faint)] py-16 text-sm" data-i18n-ui="weapons.empty.noMatches">
    No weapons match your search.
  </p>
</div>

<style is:global>
  /*
   * Two-pane weapons view: keep the LEFT list rail perfectly static during
   * client navigation and animate ONLY the right-hand detail pane. Mirrors the
   * units two-pane. The rail DOM is preserved via `transition:persist`; disable
   * the root cross-fade on weapons pages (so the persisted rail never flashes)
   * and give only the detail pane its own `view-transition-name`. Also suppress
   * the global `.fade-up` entrance on <main> (it would re-animate the persisted
   * rail on every navigation). Other pages keep their normal transition.
   */
  @media (min-width: 1024px) {
    :root:has([data-weapons-view])::view-transition-old(root),
    :root:has([data-weapons-view])::view-transition-new(root) {
      animation: none !important;
    }

    [data-weapons-view] .weapons-detail-col {
      view-transition-name: weapons-detail;
    }
  }

  main:has([data-weapons-view]) {
    animation: none !important;
  }
</style>
