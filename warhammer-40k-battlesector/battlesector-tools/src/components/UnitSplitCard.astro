---
import type { Unit } from '../lib/types';
import UnitSplitCardBody from './UnitSplitCardBody.astro';

interface Props {
  unit: Unit;
  href?: string;
  className?: string;
  variant?: 'tall' | 'wide';
  dataAttrs?: Record<string, string | number | boolean | null | undefined>;
}

const { unit, href, className = '', variant = 'tall', dataAttrs = {} } = Astro.props as Props;

const attrs = Object.fromEntries(
  Object.entries(dataAttrs).filter(([, value]) => value !== undefined && value !== null),
);

const cardClass = `unit-card surface surface-hover block p-0 overflow-hidden ${variant === 'wide' ? 'min-h-[14rem]' : 'min-h-[16rem]'} ${className}`;
---

{href ? (
  <a href={href} class={cardClass} {...attrs}>
    <UnitSplitCardBody unit={unit} variant={variant} />
  </a>
) : (
  <div class={cardClass} role="button" tabindex="0" aria-pressed="false" {...attrs}>
    <UnitSplitCardBody unit={unit} variant={variant} />
  </div>
)}
