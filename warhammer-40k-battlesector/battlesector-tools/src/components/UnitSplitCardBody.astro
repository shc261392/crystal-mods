---
import { getWeapon } from '../lib/data';
import type { Unit } from '../lib/types';
import { getAbilities } from '../lib/unit-abilities';
import { resolveWeaponType } from '../lib/weapon-display';
import {
  getFactionEmblem,
  getStatIcon,
  getUnitPortrait,
  getWeaponPortrait,
  getWeaponTypeIcon,
} from '../scripts/images';
import Tooltip from './Tooltip.astro';

interface Props {
  unit: Unit;
  variant?: 'tall' | 'wide';
}

const { unit, variant = 'tall' } = Astro.props as Props;
const portraitSizeClass = variant === 'wide' ? 'w-24 md:w-28' : 'w-32 md:w-40';
const topGapClass = variant === 'wide' ? 'gap-2.5' : 'gap-2';
const cardGapClass = variant === 'wide' ? 'gap-2.5' : 'gap-1.5';

function tierMeta(
  roleName: string,
  fallbackColor: string,
): { label: string; bg: string; ink: string } {
  if (roleName === 'HQ') return { label: 'HQ', bg: '#d4af37', ink: '#1b1206' };
  if (roleName === 'Elite') return { label: 'Elite', bg: '#7e57c2', ink: '#f8f6ff' };
  if (roleName === 'Heavy Support') return { label: 'Heavy', bg: '#3b82f6', ink: '#f3f8ff' };
  if (roleName === 'Fast Attack' || roleName === 'Flyer')
    return { label: 'Fast', bg: '#22c55e', ink: '#f4fff7' };
  if (roleName === 'Troop') return { label: 'Troop', bg: '#dc2626', ink: '#fff6f6' };
  return { label: roleName, bg: fallbackColor, ink: '#f8f8f8' };
}

const thumb = getUnitPortrait(unit.name, unit.portrait) ?? getFactionEmblem(unit.faction);
const tier = tierMeta(unit.roleName, unit.roleColor);
const unitAbilities = unit.abilityIds ? getAbilities(unit.abilityIds) : [];

// Weapon slots -> icon groups. A slot with >1 option is a "choose one" group,
// rendered inside a bordered container so the user can see the weapons are
// mutually exclusive picks.
const weaponGroups = unit.weaponSlots.map((slot) => ({
  chooseOne: slot.options.length > 1,
  options: slot.options.map((opt) => {
    const w = getWeapon(opt.weaponId);
    return {
      name: opt.name,
      icon: w ? (getWeaponPortrait(w.icon) ?? getWeaponTypeIcon(resolveWeaponType(w))) : null,
    };
  }),
}));

// Canonical stat-row spec: order, label color and in-game stat icon.
const statRows = [
  {
    stat: 'health',
    label: 'HP',
    color: '#39904B',
    // Per-model × count when multi-model (e.g. "70×5"); a lone number = 1 model.
    value: unit.members > 1 ? `${unit.maxHealth}×${unit.members}` : `${unit.totalHealth}`,
  },
  { stat: 'actionPoints', label: 'AP', color: '#8F5B36', value: unit.maxActionPoints },
  { stat: 'movement', label: 'MP', color: '#2662AA', value: unit.maxMovementPoints },
  {
    stat: 'armor',
    label: 'Armor',
    color: '#6299B8',
    value: unit.armorProfile === 1 ? unit.armorFront : unit.armor,
  },
  { stat: 'evasion', label: 'Dodge', color: '#9F895A', value: unit.evasion },
];
---

<div class={`flex h-full flex-col ${cardGapClass} p-3`}>
  <!-- Top area (grows to fill height above the stat row). Portrait fills its full height. -->
  <div class={`flex items-start ${topGapClass} flex-1 min-h-0`}>
    <div class={`${portraitSizeClass} aspect-square shrink-0 rounded-lg overflow-hidden border border-black/25`} style={`background:${tier.bg}; color:${tier.ink}`}>
      {thumb ? (
        <img src={thumb} alt="" width="128" height="128" loading="lazy" decoding="async" class="w-full h-full object-cover object-top" />
      ) : (
        <div class="w-full h-full grid place-items-center font-black text-3xl" aria-hidden="true">{unit.factionName.slice(0, 1)}</div>
      )}
    </div>

    <div class="min-w-0 flex-1 flex flex-col gap-2" data-card-actions-anchor>
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <h3 class="font-extrabold leading-tight text-sm line-clamp-2" data-i18n-unit={unit.id} data-i18n-fallback={unit.name}>{unit.name}</h3>
          <p class="text-[11px] leading-tight text-[var(--color-muted)] mt-0.5 truncate" data-i18n-faction={unit.faction} data-i18n-fallback={unit.factionName}>{unit.factionName}</p>
        </div>
        <div class="text-right shrink-0">
          <p class="text-[9px] uppercase tracking-wide text-[var(--color-faint)] leading-none">Unit PTS</p>
          <p class="font-black text-lg text-[var(--color-gold)] leading-tight">{unit.pointCost}</p>
        </div>
      </div>

      {weaponGroups.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {weaponGroups.map((g) => (
            <div class={`flex items-center gap-0.5 rounded ${g.chooseOne ? 'ring-1 ring-[var(--color-gold-dim)]/60 bg-black/25 px-1 py-0.5' : ''}`} title={g.chooseOne ? 'Choose one' : undefined}>
              {g.options.map((wi, idx) => (
                <>
                  {idx > 0 && g.chooseOne && <span class="text-[10px] font-bold text-[var(--color-gold-dim)] px-px" aria-hidden="true">/</span>}
                  <Tooltip text={g.chooseOne ? `${wi.name} (choose one)` : wi.name}>
                    {wi.icon ? (
                      <img src={wi.icon} alt={wi.name} width="32" height="32" loading="lazy" decoding="async" class="w-8 h-8 rounded bg-black/30 border border-[var(--color-border)] object-contain p-1" />
                    ) : (
                      <span class="w-8 h-8 rounded bg-black/30 border border-[var(--color-border)] grid place-items-center text-[11px] text-[var(--color-faint)]">?</span>
                    )}
                  </Tooltip>
                </>
              ))}
            </div>
          ))}
        </div>
      )}

      {unitAbilities.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {unitAbilities.map((ability) => (
            ability.icon && (
              <Tooltip text={ability.title}>
                <img src={ability.icon} alt={ability.title} width="32" height="32" loading="lazy" decoding="async" class="w-8 h-8 rounded border border-[var(--color-border)] bg-black/30 object-contain p-1" />
              </Tooltip>
            )
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- Stats: single compact row (< 1/4 of the card). -->
  <dl class="grid grid-cols-5 gap-1">
    {statRows.map((row) => (
      <div class="flex flex-col items-center rounded-md border border-[var(--color-border)] bg-[var(--color-base)] px-1 py-1.5">
        <dt class="inline-flex items-center gap-0.5 text-[9px] font-semibold uppercase tracking-wide" style={`color:${row.color}`}>
          {getStatIcon(row.stat) && (
            <svg class="w-3 h-3 shrink-0" viewBox="0 0 14 14" aria-hidden="true">
              <defs>
                <mask id={`unit-card-mask-${unit.id}-${row.stat}`} maskUnits="userSpaceOnUse" x="0" y="0" width="14" height="14">
                  <image href={getStatIcon(row.stat)!} x="0" y="0" width="14" height="14" preserveAspectRatio="xMidYMid meet" />
                </mask>
              </defs>
              <rect x="0" y="0" width="14" height="14" fill={row.color} mask={`url(#unit-card-mask-${unit.id}-${row.stat})`} />
            </svg>
          )}
          {row.label}
        </dt>
        <dd class="text-sm font-bold tabular-nums leading-tight mt-0.5">{row.value}</dd>
      </div>
    ))}
  </dl>

  <!-- Army Builder quick +/- controls are injected here by script so they sit
       below the stat row instead of inside the top content pane. -->
  <div data-card-qty-anchor class="pt-0.5"></div>
</div>
