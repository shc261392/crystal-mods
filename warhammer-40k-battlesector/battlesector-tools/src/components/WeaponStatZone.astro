---
import { damageRange, splashDamage } from '../lib/combat';
import type { Weapon } from '../lib/types';
import { weaponTypeMeta } from '../lib/weapon-display';

interface Props {
  weapon: Weapon;
  /** Unit melee accuracy, used when a melee weapon has no accuracy of its own. */
  meleeAccuracyFallback?: number;
  compact?: boolean;
}

const { weapon: w, meleeAccuracyFallback, compact = false } = Astro.props;

const dr = damageRange(w.damage);
const dmg = dr.min === dr.max ? `${dr.max}` : `${dr.min}–${dr.max}`;
const acc = w.isMelee && w.accuracy <= 0 ? (meleeAccuracyFallback ?? w.accuracy) : w.accuracy;
const splash = splashDamage(w);
const hasRange = !w.isMelee && w.rangeMax > 0;
const typeMeta = weaponTypeMeta(w);

// Each stat cell: label key + fallback text, value, colour var.
type Cell = { key: string; label: string; value: string; color: string };
const cells: Cell[] = [
  {
    key: 'weaponStat.type',
    label: 'Type',
    value: typeMeta.label,
    color: typeMeta.color,
  },
  {
    key: 'weaponStat.dmg',
    label: 'DMG',
    value: w.numAttacks > 1 ? `${dmg} ×${w.numAttacks}` : dmg,
    color: 'var(--color-hp)',
  },
];

// Splash between DMG and AP (user requested order)
if (splash) {
  cells.push({
    key: 'weaponStat.splash',
    label: 'SPLASH',
    value: `${splash.min}–${splash.max} ×${splash.models}`,
    color: 'var(--color-toxin)',
  });
}

// AP before ACC (user requested this order)
if (w.armorPiercing > 0) {
  cells.push({
    key: 'weaponStat.ap',
    label: 'AP',
    value: `${w.armorPiercing}`,
    color: 'var(--color-gold-dim)',
  });
}

cells.push({ key: 'weaponStat.acc', label: 'ACC', value: `${acc}%`, color: 'var(--color-gold)' });

if (hasRange) {
  // Show range with optimal value (user requested: "Range: 1-3 (Optimal: 1)")
  const rangeDisplay =
    w.rangeOptimal > 0 && w.rangeOptimal !== w.rangeMax
      ? `${w.rangeMin}–${w.rangeMax} (${w.rangeOptimal})`
      : `${w.rangeMin}–${w.rangeMax}`;
  cells.push({
    key: 'weaponStat.rng',
    label: 'RNG',
    value: rangeDisplay,
    color: 'var(--color-momentum)',
  });
}

const typeI18n = typeMeta.i18nKey;
---

<div class={`weapon-stats ${compact ? 'is-compact' : ''}`}>
  {cells.map((c, i) => (
    <div class="wstat" style={`--wstat-color:${c.color}`}>
      <span class="wstat-label" data-i18n-ui={c.key}>{c.label}</span>
      {i === 0 ? (
        <span class="wstat-value" data-i18n-ui={typeI18n}>{c.value}</span>
      ) : (
        <span class="wstat-value tabular-nums">{c.value}</span>
      )}
    </div>
  ))}
</div>

<style>
  .weapon-stats {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-base) 55%, transparent);
  }

  .wstat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    flex: 1 1 0;
    min-width: 3.25rem;
    padding: 0.4rem 0.5rem;
    text-align: center;
    border-left: 1px solid var(--color-border);
  }

  .wstat:first-child {
    border-left: none;
  }

  .is-compact .wstat {
    min-width: 2.75rem;
    padding: 0.3rem 0.375rem;
    gap: 0.1rem;
  }

  .wstat-label {
    font-size: 0.5rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .wstat-value {
    font-size: 0.8125rem;
    line-height: 1;
    font-weight: 800;
    color: var(--wstat-color);
  }

  .is-compact .wstat-value {
    font-size: 0.75rem;
  }
</style>
