---
import { ClientRouter } from 'astro:transitions';
import ArmyDrawer from '../components/ArmyDrawer.astro';
import Nav from '../components/Nav.astro';
import buildMeta from '../data/build-meta.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Optional path for canonical/OG URL, e.g. "/units/1006-tyranid-termagant". */
  path?: string;
  ogType?: string;
}

const {
  title,
  description = 'Web tools for Warhammer 40,000: Battlesector — browse units, weapons and abilities, build army lists, and calculate damage.',
  path = '',
  ogType = 'website',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${site}${path}`;
const fullTitle = title === 'Battlesector Tools' ? title : `${title} — Battlesector Tools`;
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#15171f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Battlesector Tools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${site}/og.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og.svg`} />

    <ClientRouter />

    <link rel="preconnect" href="https://rsms.me" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.18/dist/katex.min.css" integrity="sha384-veTAhWILPOotXm+kbR5uY7dRamYLJf58I7P+hJhjeuc7hsMAkJHTsPahAl0hBST0" crossorigin="anonymous" />
    <script is:inline>
      (() => {
        const KEY = 'bs.locale.v1';
        const params = new URLSearchParams(location.search);
        const fromUrl = params.get('lang');
        const stored = localStorage.getItem(KEY);
        const locale = fromUrl || stored || 'en';
        document.documentElement.lang = locale;
        if (locale !== 'en') {
          document.documentElement.classList.add('i18n-pending');
        }
      })();
    </script>
    <style>
      html.i18n-pending body {
        visibility: hidden;
      }
    </style>
  </head>
  <body>
    <Nav />
    <div class="lg:pl-[76px] pb-20 lg:pb-0">
      <div class="border-y border-[color-mix(in_oklab,var(--color-gold)_45%,var(--color-border))] bg-[color-mix(in_oklab,var(--color-gold)_14%,transparent)]">
        <div class="container-page py-2.5 text-sm font-semibold text-[var(--color-ink)]">
          The website is WIP. Some data may be wrong or missing.
        </div>
      </div>
      <main class="container-page py-8 md:py-10 fade-up">
        <slot />
      </main>
      <slot name="modals" />
      <footer class="border-t border-[var(--color-border)] mt-16">
        <div class="container-page py-8 text-sm text-[var(--color-faint)] flex flex-col md:flex-row gap-3 md:items-center md:justify-between">
          <p>
            <span data-i18n-ui="footer.disclaimer.main">
            An unofficial Battlesector Tools fan project. Game data extracted for
            reference and analysis.
            </span>
          </p>
          <p>
            <span data-i18n-ui="footer.disclaimer.copyright">
            Warhammer 40,000: Battlesector © Games Workshop / Black Lab Games.
            Not affiliated.
            </span>
          </p>
          <nav class="flex items-center gap-4 shrink-0">
            <a href="/privacy" class="hover:text-[var(--color-gold-dim)] transition-colors" data-i18n-ui="footer.privacy">Privacy</a>
            <a href="mailto:shadowevor@proton.me" class="hover:text-[var(--color-gold-dim)] transition-colors" data-i18n-ui="footer.contact">Contact</a>
            <span class="text-[var(--color-faint)] tabular-nums" title="Build version">v{buildMeta.version}+{buildMeta.hash}</span>
          </nav>
        </div>
      </footer>
    </div>

    <ArmyDrawer />

    <script>
      import { initTooltips } from '../scripts/tooltip';
      import { onPageLoad } from '../scripts/reinit';
      import { initArmyDrawer } from '../scripts/army-drawer';
      initTooltips();
      onPageLoad(initArmyDrawer);
    </script>
  </body>
</html>
