{
  "name": "battlesector-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "predeploy-check": "node ./scripts/predeploy-check.ts",
    "deploy": "pnpm predeploy-check && pnpm lint && pnpm build && node ./scripts/strip-local-pages.ts && dotenvx run -f .env.production -- wrangler deploy",
    "deploy:dry": "pnpm predeploy-check && pnpm lint && pnpm build && node ./scripts/strip-local-pages.ts && dotenvx run -f .env.production -- wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "check": "astro check",
    "gen:abilities": "node ./scripts/generate-ability-ui.ts",
    "i18n:audit": "node ./scripts/i18n-audit.ts",
    "i18n:integrate-abilities": "node ./scripts/integrate-ability-i18n.ts",
    "i18n:integrate-abilities:dry": "node ./scripts/integrate-ability-i18n.ts --dry-run",
    "i18n:suggest-weapon-exclusions": "node ./scripts/suggest-weapon-exclusions.ts zh-TW",
    "lint": "biome check . --vcs-enabled=true --vcs-use-ignore-file=true",
    "format": "biome format --write . --vcs-enabled=true --vcs-use-ignore-file=true"
  },
  "dependencies": {
    "astro": "^5.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^1.9.4",
    "@dotenvx/dotenvx": "^1.49.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^26.0.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "wrangler": "^4.12.0"
  }
}
