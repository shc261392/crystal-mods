{
  "name": "battlesector-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy --assets ./dist",
    "deploy:dry": "pnpm build && wrangler deploy --assets ./dist --dry-run",
    "cf-typegen": "wrangler types",
    "check": "astro check",
    "i18n:audit": "node ./scripts/i18n-audit.mjs",
    "i18n:suggest-weapon-exclusions": "node ./scripts/suggest-weapon-exclusions.mjs zh-TW",
    "lint": "biome check . --vcs-enabled=true --vcs-use-ignore-file=true",
    "format": "biome format --write . --vcs-enabled=true --vcs-use-ignore-file=true"
  },
  "dependencies": {
    "astro": "^5.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.0.6",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "wrangler": "^4.12.0"
  }
}
